{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarm-inference-lab.local/schemas/colibri/capability-report-v1.schema.json",
  "title": "Colibri capability report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend", "colibri_version", "colibri_commit", "bridge_version",
    "platform", "architecture", "model_families", "execution_backends",
    "quantization_formats", "supports_cpu", "supports_cuda", "supports_vulkan",
    "supports_metal", "supports_multi_gpu", "supports_expert_residency",
    "supports_route_trace", "supports_usage_history", "supports_expert_prefetch",
    "supports_dynamic_reconfiguration", "supports_native_mxfp4",
    "supports_tensor_microshards", "supports_full_expert_placement",
    "supports_exact_replay", "supports_prefill_decode_separation", "storage_tiers",
    "gpu_devices", "cpu", "memory", "storage"
  ],
  "properties": {
    "backend": {"const": "colibri"},
    "colibri_version": {"type": "string"},
    "colibri_commit": {"type": "string"},
    "bridge_version": {"type": "string"},
    "platform": {"type": "string"},
    "architecture": {"type": "string"},
    "model_families": {"type": "array", "items": {"type": "string"}},
    "execution_backends": {"type": "array", "items": {"type": "string"}},
    "quantization_formats": {"type": "array", "items": {"type": "string"}},
    "supports_cpu": {"type": "boolean"},
    "supports_cuda": {"type": "boolean"},
    "supports_vulkan": {"type": "boolean"},
    "supports_metal": {"type": "boolean"},
    "supports_multi_gpu": {"type": "boolean"},
    "supports_expert_residency": {"type": "boolean"},
    "supports_route_trace": {"type": "boolean"},
    "supports_usage_history": {"type": "boolean"},
    "supports_expert_prefetch": {"type": "boolean"},
    "supports_dynamic_reconfiguration": {"type": "boolean"},
    "supports_native_mxfp4": {"type": "boolean"},
    "supports_tensor_microshards": {"type": "boolean"},
    "supports_full_expert_placement": {"type": "boolean"},
    "supports_exact_replay": {"type": "boolean"},
    "supports_prefill_decode_separation": {"type": "boolean"},
    "storage_tiers": {"type": "array", "items": {"type": "object"}},
    "gpu_devices": {"type": "array", "items": {"type": "object"}},
    "cpu": {"type": "object"},
    "memory": {"type": "object"},
    "storage": {"type": "object"}
  }
}

