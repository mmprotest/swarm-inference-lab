@@ -7032,6 +7032,17 @@ static void mux_done(Model *m, ServeCtx *sc, ServeReq *r){
            edisk_s()-r->pb.edisk,m->t_ewait-r->pb.ewait,m->t_emm-r->pb.emm,
            m->t_attn-r->pb.attn,m->t_head-r->pb.head,
            (unsigned long long)(m->n_fw-r->pb.n_fw));
+    /* SWARM BRIDGE PATCH: exact aggregate counters already maintained by the
+     * engine. Observation only; no routing, cache, or execution decision is
+     * changed. CACHESTAT <id> <pin-hit> <lru-hit> <miss> <read-bytes>
+     * <read-service-s> <felt-wait-s> <cpu-expert-s> <gpu-expert-s>. */
+    printf("CACHESTAT %llu %llu %llu %llu %lld %.9f %.9f %.9f %.9f\n",r->id,
+           (unsigned long long)(m->hit_pin-r->pb.hit_pin),
+           (unsigned long long)(m->hit_ecache-r->pb.hit_ecache),
+           (unsigned long long)(m->miss-r->pb.miss),
+           (long long)(atomic_load_explicit(&g_prof_io,memory_order_relaxed)-r->pb.io),
+           edisk_s()-r->pb.edisk,m->t_ewait-r->pb.ewait,
+           m->t_ecpu-r->pb.ecpu,m->t_egpu-r->pb.egpu);
     printf("DONE %llu STAT %d %.2f %.1f %.2f %d %d\n",r->id,r->emitted,
            r->emitted/dt,(dh+dm)>0?100.0*dh/(dh+dm):0.0,rss_gb(),
            r->prompt_tokens,r->length_limited);
