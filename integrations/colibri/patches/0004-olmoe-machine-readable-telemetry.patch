+/* SWARM BRIDGE PATCH: serialize already-measured OLMoE state only after the
+ * engine has made its routing/residency decisions. */
+static uint64_t swb_expert_bytes(const Model *m) {
+    return (uint64_t)(2ull * (uint64_t)m->c.inter * (uint64_t)m->c.hidden
+                    + (uint64_t)m->c.hidden * (uint64_t)m->c.inter)
+         + 4ull * (uint64_t)(2 * m->c.inter + m->c.hidden);
+}
+
+static uint64_t swb_resident_expert_bytes(const Model *m) {
+    uint64_t slots = 0;
+    for (int layer = 0; layer < m->c.n_layers; layer++) slots += (uint64_t)m->cache[layer].n;
+    return slots * swb_expert_bytes(m);
+}
+
+static void swb_olmoe_ready(const Model *m, int cap, int bits) {
+    char payload[1024];
+    uint64_t one = swb_expert_bytes(m);
+    uint64_t cache_capacity = one * (uint64_t)cap * (uint64_t)m->c.n_layers;
+    uint64_t backing = one * (uint64_t)m->c.n_experts * (uint64_t)m->c.n_layers;
+    snprintf(payload, sizeof(payload),
+             "{\"model_family\":\"olmoe\",\"layers\":%d,\"experts_per_layer\":%d,"
+             "\"experts_per_token\":%d,\"expert_native_format\":\"merged_int8_per_row\","
+             "\"quant_bits\":%d}",
+             m->c.n_layers, m->c.n_experts, m->c.topk, bits);
+    swb_emit(1, "model_inventory", payload, 0);
+    snprintf(payload, sizeof(payload),
+             "{\"tiers\":[{\"tier\":\"vram\",\"allocated_expert_bytes\":0},"
+             "{\"tier\":\"ram\",\"allocated_expert_bytes\":%llu,"
+             "\"expert_cache_capacity_bytes\":%llu},{\"tier\":\"nvme\","
+             "\"allocated_expert_bytes\":%llu}],\"expert_bytes\":%llu}",
+             (unsigned long long)swb_resident_expert_bytes(m),
+             (unsigned long long)cache_capacity, (unsigned long long)backing,
+             (unsigned long long)one);
+    swb_emit(1, "tier_inventory", payload, 0);
+    snprintf(payload, sizeof(payload),
+             "{\"cache_slots_per_layer\":%d,\"pilot_depth\":%d,\"pilot_width\":%d,"
+             "\"hot_experts_per_layer\":%d,\"execution_tier\":\"ram\","
+             "\"cold_tier\":\"nvme\"}",
+             cap, g_pilot, g_wide, m->hot_n);
+    swb_emit(1, "placement_plan", payload, 0);
+    snprintf(payload, sizeof(payload),
+             "{\"rss_bytes\":%llu,\"dense_load_duration_ns\":%llu}",
+             (unsigned long long)(rss_gb() * 1000000000.0),
+             (unsigned long long)(m->dense_load_s * 1000000000.0));
+    swb_emit(1, "resource_snapshot", payload, 0);
+    swb_emit(1, "engine_ready", "{}", 0);
+}
+
+static void swb_olmoe_request_started(int prompt_tokens, int completion_tokens) {
+    char payload[256];
+    snprintf(payload, sizeof(payload),
+             "{\"prompt_tokens\":%d,\"max_tokens\":%d,\"teacher_forced\":%s}",
+             prompt_tokens, completion_tokens, getenv("PPL") ? "true" : "false");
+    swb_emit(1, "request_started", payload, 1);
+    snprintf(payload, sizeof(payload), "{\"prompt_tokens\":%d}", prompt_tokens);
+    swb_emit(1, "prefill_started", payload, 1);
+}
+
+static void swb_olmoe_request_completed(Model *m, int completion_tokens,
+                                        double elapsed_s, const char *stop_reason) {
+    if (g_pilot) {
+        double deadline = now_s() + 5.0;
+        while (__atomic_load_n(&pilot_r, __ATOMIC_ACQUIRE)
+               != __atomic_load_n(&pilot_w, __ATOMIC_ACQUIRE)
+               && now_s() < deadline)
+            sleep_ms(1);
+        pthread_mutex_lock(&g_pilot_mx);
+        for (int layer = 0; layer < m->c.n_layers; layer++)
+            for (int slot = 0; slot < m->cache[layer].n; slot++)
+                if (m->cache[layer].slots[slot].prefetched) {
+                    m->prefetch_wasted_loads++;
+                    m->cache[layer].slots[slot].prefetched = 0;
+                }
+        pthread_mutex_unlock(&g_pilot_mx);
+    }
+    char payload[1024];
+    uint64_t one = swb_expert_bytes(m);
+    uint64_t hits = m->hits, misses = m->miss;
+    uint64_t selections = hits + misses;
+    snprintf(payload, sizeof(payload),
+             "{\"selection_count\":%llu,\"cache_hits\":%llu,\"cache_misses\":%llu,"
+             "\"execution_tier\":\"ram\",\"prefill_tokens\":%llu,"
+             "\"decode_tokens\":%llu}",
+             (unsigned long long)selections, (unsigned long long)hits,
+             (unsigned long long)misses, (unsigned long long)m->prefill_tokens,
+             (unsigned long long)m->decode_tokens);
+    swb_emit(1, "route_summary", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"tier\":\"ram\",\"aggregate\":true}",
+             (unsigned long long)hits);
+    swb_emit(1, "expert_cache_hit", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"source_tier\":\"nvme\",\"aggregate\":true}",
+             (unsigned long long)misses);
+    swb_emit(1, "expert_cache_miss", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"demand_count\":%llu,\"prefetch_count\":%llu,"
+             "\"source_tier\":\"nvme\",\"target_tier\":\"ram\",\"aggregate\":true}",
+             (unsigned long long)(m->demand_loads + m->prefetch_loads),
+             (unsigned long long)m->demand_loads, (unsigned long long)m->prefetch_loads);
+    swb_emit(1, "expert_loaded", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"aggregate\":true}",
+             (unsigned long long)m->prefetch_loads);
+    swb_emit(1, "expert_prefetch_started", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"useful_count\":%llu,\"wasted_count\":%llu,"
+             "\"useful_bytes\":%llu,\"wasted_bytes\":%llu,\"aggregate\":true}",
+             (unsigned long long)m->prefetch_loads,
+             (unsigned long long)m->prefetch_useful_loads,
+             (unsigned long long)m->prefetch_wasted_loads,
+             (unsigned long long)(m->prefetch_useful_loads * one),
+             (unsigned long long)(m->prefetch_wasted_loads * one));
+    swb_emit(1, "expert_prefetch_completed", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"count\":%llu,\"tier\":\"ram\",\"aggregate\":true}",
+             (unsigned long long)m->evictions);
+    swb_emit(1, "expert_evicted", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"read_count\":%llu,\"byte_count\":%llu,\"duration_ns\":%llu,"
+             "\"source_tier\":\"nvme\",\"target_tier\":\"ram\","
+             "\"page_cache_possible\":true,\"aggregate\":true}",
+             (unsigned long long)m->storage_read_count,
+             (unsigned long long)m->storage_read_bytes,
+             (unsigned long long)(m->storage_read_s * 1000000000.0));
+    swb_emit(1, "storage_read", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"duration_ns\":%llu,\"scope\":\"routed_experts\","
+             "\"backend\":\"cpu\",\"aggregate\":true}",
+             (unsigned long long)(m->cpu_expert_s * 1000000000.0));
+    swb_emit(1, "cpu_compute", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"rss_bytes\":%llu,\"resident_expert_bytes\":%llu,"
+             "\"storage_read_bytes\":%llu}",
+             (unsigned long long)(rss_gb() * 1000000000.0),
+             (unsigned long long)swb_resident_expert_bytes(m),
+             (unsigned long long)m->storage_read_bytes);
+    swb_emit(1, "resource_snapshot", payload, 1);
+    snprintf(payload, sizeof(payload),
+             "{\"completion_tokens\":%d,\"elapsed_ns\":%llu,"
+             "\"decode_tokens_per_second\":%.9f,\"stop_reason\":\"%s\","
+             "\"prefill_duration_ns\":%llu,\"decode_duration_ns\":%llu}",
+             completion_tokens, (unsigned long long)(elapsed_s * 1000000000.0),
+             elapsed_s > 0 ? completion_tokens / elapsed_s : 0.0, stop_reason,
+             (unsigned long long)(m->prefill_s * 1000000000.0),
+             (unsigned long long)(m->decode_s * 1000000000.0));
+    swb_emit(1, "request_completed", payload, 1);
+}
