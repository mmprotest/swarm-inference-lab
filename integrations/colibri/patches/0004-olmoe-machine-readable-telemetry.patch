new file mode 100644
index 0000000000000000000000000000000000000000..c51d42fe27388aba35f1d23db0402aff636d22e1
--- /dev/null
+++ b/c/swarm_bridge_c.h
@@ -0,0 +1,137 @@
+/* Optional semantics-neutral NDJSON bridge for one-shot C engines.
+ *
+ * This header owns only a dedicated observation stream.  It never mutates
+ * model state, weights, router output, sampling, tokenization, or execution
+ * policy.  Engine-specific code supplies already-measured counters as JSON
+ * payloads after inference.
+ */
+#ifndef SWARM_BRIDGE_C_H
+#define SWARM_BRIDGE_C_H
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifdef _WIN32
+#include <windows.h>
+#include <process.h>
+#define SWB_GETPID _getpid
+#else
+#include <unistd.h>
+#define SWB_GETPID getpid
+#endif
+
+typedef struct {
+    FILE *fp;
+    unsigned long long sequence;
+    int level;
+    int pid;
+    const char *model_id;
+    const char *model_revision;
+    const char *family;
+    const char *request_id;
+} SwarmBridgeC;
+
+static SwarmBridgeC g_swb;
+
+static int swb_level(const char *value) {
+    if (!value || !*value || !strcmp(value, "summary")) return 1;
+    if (!strcmp(value, "off")) return 0;
+    if (!strcmp(value, "detailed")) return 2;
+    if (!strcmp(value, "trace")) return 3;
+    return -1;
+}
+
+static unsigned long long swb_timestamp_ns(void) {
+#ifdef _WIN32
+    FILETIME ft;
+    ULARGE_INTEGER ticks;
+    GetSystemTimeAsFileTime(&ft);
+    ticks.LowPart = ft.dwLowDateTime;
+    ticks.HighPart = ft.dwHighDateTime;
+    /* FILETIME is 100 ns since 1601-01-01; Unix epoch starts in 1970. */
+    return (ticks.QuadPart - 116444736000000000ull) * 100ull;
+#else
+    struct timespec ts;
+    if (clock_gettime(CLOCK_REALTIME, &ts) != 0) return 0;
+    return (unsigned long long)ts.tv_sec * 1000000000ull + (unsigned long long)ts.tv_nsec;
+#endif
+}
+
+static void swb_json_string(FILE *fp, const char *value) {
+    const unsigned char *p = (const unsigned char *)(value ? value : "");
+    fputc('"', fp);
+    for (; *p; p++) {
+        switch (*p) {
+            case '"': fputs("\\\"", fp); break;
+            case '\\': fputs("\\\\", fp); break;
+            case '\b': fputs("\\b", fp); break;
+            case '\f': fputs("\\f", fp); break;
+            case '\n': fputs("\\n", fp); break;
+            case '\r': fputs("\\r", fp); break;
+            case '\t': fputs("\\t", fp); break;
+            default:
+                if (*p < 0x20) fprintf(fp, "\\u%04x", (unsigned)*p);
+                else fputc(*p, fp);
+        }
+    }
+    fputc('"', fp);
+}
+
+static void swb_emit(int minimum_level, const char *event_type,
+                     const char *payload_json, int request_scoped) {
+    if (!g_swb.fp || g_swb.level < minimum_level) return;
+    fputs("{\"schema_version\":\"1.0\",\"event_type\":", g_swb.fp);
+    swb_json_string(g_swb.fp, event_type);
+    fprintf(g_swb.fp, ",\"timestamp_ns\":%llu,\"engine_pid\":%d,\"request_id\":",
+            swb_timestamp_ns(), g_swb.pid);
+    if (request_scoped && g_swb.request_id && *g_swb.request_id)
+        swb_json_string(g_swb.fp, g_swb.request_id);
+    else
+        fputs("null", g_swb.fp);
+    fputs(",\"model_id\":", g_swb.fp); swb_json_string(g_swb.fp, g_swb.model_id);
+    fputs(",\"model_revision\":", g_swb.fp); swb_json_string(g_swb.fp, g_swb.model_revision);
+    fputs(",\"engine_family\":", g_swb.fp); swb_json_string(g_swb.fp, g_swb.family);
+    fprintf(g_swb.fp, ",\"sequence_number\":%llu,\"payload\":%s}\n",
+            g_swb.sequence++, payload_json ? payload_json : "{}");
+    fflush(g_swb.fp);
+}
+
+static void swb_init(const char *family, const char *snapshot) {
+    memset(&g_swb, 0, sizeof(g_swb));
+    if (!getenv("COLI_SWARM_BRIDGE") || strcmp(getenv("COLI_SWARM_BRIDGE"), "1")) return;
+    g_swb.level = swb_level(getenv("COLI_SWARM_TELEMETRY"));
+    if (g_swb.level <= 0) return;
+    const char *path = getenv("COLI_SWARM_BRIDGE_PATH");
+    char fallback[4096];
+    if (!path || !*path) {
+        snprintf(fallback, sizeof(fallback), "%s/.coli_swarm_telemetry.ndjson", snapshot);
+        path = fallback;
+    }
+    g_swb.fp = fopen(path, "ab");
+    if (!g_swb.fp) {
+        fprintf(stderr, "[SWARM_BRIDGE] cannot open dedicated telemetry file %s\n", path);
+        return;
+    }
+    g_swb.pid = (int)SWB_GETPID();
+    g_swb.family = family ? family : "";
+    g_swb.model_id = getenv("COLI_MODEL_ID") ? getenv("COLI_MODEL_ID") : snapshot;
+    g_swb.model_revision = getenv("COLI_MODEL_REVISION") ? getenv("COLI_MODEL_REVISION") : "";
+    g_swb.request_id = getenv("COLI_REQUEST_ID");
+    char payload[256];
+    snprintf(payload, sizeof(payload),
+             "{\"bridge_version\":\"1.0\",\"telemetry_level\":\"%s\"}",
+             getenv("COLI_SWARM_TELEMETRY") ? getenv("COLI_SWARM_TELEMETRY") : "summary");
+    swb_emit(1, "engine_started", payload, 0);
+}
+
+static void swb_close(int exit_code) {
+    if (!g_swb.fp) return;
+    char payload[64];
+    snprintf(payload, sizeof(payload), "{\"exit_code\":%d}", exit_code);
+    swb_emit(1, "engine_stopped", payload, 0);
+    fclose(g_swb.fp);
+    g_swb.fp = NULL;
+}
+
+#endif
