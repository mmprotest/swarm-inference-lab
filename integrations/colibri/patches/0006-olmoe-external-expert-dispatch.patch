+            free(context); olmoe_socket_close(socket); continue;
+        }
+        pthread_detach(client);
+    }
+    state.shutdown = 1; olmoe_socket_close(state.control_listener); pthread_join(control, NULL);
+    olmoe_expert_runtime_close(state.runtime); pthread_mutex_destroy(&state.runtime_mutex);
+    return 0;
+}
