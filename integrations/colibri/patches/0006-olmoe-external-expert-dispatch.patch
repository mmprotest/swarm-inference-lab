+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * External expert dispatch after native routing and before residual addition.
+ */
+#ifndef OLMOE_EXTERNAL_DISPATCH_H
+#define OLMOE_EXTERNAL_DISPATCH_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct olmoe_external_dispatch olmoe_external_dispatch;
+
+int olmoe_external_dispatch_open(
+    const char *model_path,
+    int hidden_dim,
+    int intermediate_dim,
+    int n_layers,
+    int n_experts,
+    int top_k,
+    olmoe_external_dispatch **out
+);
+
+int olmoe_external_dispatch_enabled(const olmoe_external_dispatch *dispatch);
+int olmoe_external_dispatch_is_remote(
+    const olmoe_external_dispatch *dispatch,
+    int layer_id,
+    int expert_id
+);
+
+int olmoe_external_dispatch_execute(
+    olmoe_external_dispatch *dispatch,
+    int token_position,
+    int layer_id,
+    int batch_rows,
+    const int *expert_ids_by_row,
+    const float *routing_weights_by_row,
+    const float *activations,
+    float *per_rank_contributions,
+    uint64_t *remote_result_count
+);
+
+void olmoe_external_dispatch_forbidden_local_load(
+    olmoe_external_dispatch *dispatch,
+    int token_position,
+    int layer_id,
+    int expert_id
+);
+
+uint64_t olmoe_external_dispatch_forbidden_count(
+    const olmoe_external_dispatch *dispatch
+);
+uint64_t olmoe_external_dispatch_consumed_count(
+    const olmoe_external_dispatch *dispatch
+);
+const char *olmoe_external_dispatch_last_error(
+    const olmoe_external_dispatch *dispatch
+);
+void olmoe_external_dispatch_close(olmoe_external_dispatch *dispatch);
+
+#endif
diff --git a/c/tests/test_olmoe_external_dispatch.c b/c/tests/test_olmoe_external_dispatch.c
new file mode 100644
index 0000000..07209e6
--- /dev/null
+++ b/c/tests/test_olmoe_external_dispatch.c
@@ -0,0 +1,33 @@
+/* Copyright 2025 Colibri contributors; SPDX-License-Identifier: Apache-2.0
+ * Downstream Experiment 010 external-dispatch fail-closed test. */
+#define _POSIX_C_SOURCE 200809L
+#include "../olmoe_external_dispatch.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static int set_environment(const char *name, const char *value) {
+#ifdef _WIN32
+    return _putenv_s(name, value ? value : "");
+#else
+    return value ? setenv(name, value, 1) : unsetenv(name);
+#endif
+}
+
+int main(void) {
+    olmoe_external_dispatch *dispatch = NULL;
+    if (set_environment("COLI_SWARM_EXPERT_MODE", "local") != 0) return 1;
+    if (olmoe_external_dispatch_open("unused", 4, 3, 2, 4, 2, &dispatch) != 0)
+        return 2;
+    if (!dispatch || olmoe_external_dispatch_enabled(dispatch) ||
+        olmoe_external_dispatch_is_remote(dispatch, 0, 0)) return 3;
+    olmoe_external_dispatch_close(dispatch);
+
+    dispatch = NULL;
+    if (set_environment("COLI_SWARM_EXPERT_MODE", "unsupported") != 0) return 4;
+    if (olmoe_external_dispatch_open("unused", 4, 3, 2, 4, 2, &dispatch) == 0 || dispatch)
+        return 5;
+    if (set_environment("COLI_SWARM_EXPERT_MODE", "") != 0) return 6;
+    puts("external expert dispatch preserves local mode and rejects unsupported modes");
+    return 0;
+}
