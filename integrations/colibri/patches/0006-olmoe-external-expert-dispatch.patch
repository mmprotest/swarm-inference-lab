+        state->worker_id, state->model_fingerprint);
+    return fclose(file) == 0 ? 0 : -1;
+}
+
+static int serve(const char *configuration, const char *ready_path) {
+    worker_state state; memset(&state, 0, sizeof(state));
+    state.data_listener = state.control_listener = OLMOE_INVALID_SOCKET;
+    pthread_mutex_init(&state.runtime_mutex, NULL);
+    char model_path[2048], ownership_path[2048], error[1024]; size_t budget;
+    if (load_configuration(configuration, &state, model_path, ownership_path, &budget) != 0) {
+        fprintf(stderr, "invalid native expert worker configuration\n"); return 2;
+    }
+    if (olmoe_expert_runtime_open(model_path, ownership_path, budget, &state.runtime) != 0) {
+        fprintf(stderr, "cannot open native expert bank\n"); return 3;
+    }
+    if (olmoe_socket_listen(state.host, state.data_port, 64, &state.data_listener,
+            &state.data_port, error, sizeof(error)) != 0 ||
+        olmoe_socket_listen(state.host, state.control_port, 16, &state.control_listener,
+            &state.control_port, error, sizeof(error)) != 0) {
+        fprintf(stderr, "cannot start native worker listeners: %s\n", error); return 4;
+    }
+    pthread_t control;
+    if (pthread_create(&control, NULL, control_server, &state) != 0 || write_ready(ready_path, &state) != 0) {
+        fprintf(stderr, "cannot start native worker control plane or ready file\n"); return 5;
+    }
+    while (!state.shutdown) {
+        olmoe_socket socket;
