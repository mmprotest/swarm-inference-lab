+    if (parse_positive_env("COLI_SWARM_EXPERT_TIMEOUT_MS", 30000, 600000, &dispatch->timeout_ms) != 0) {
+        dispatch_error(dispatch, "COLI_SWARM_EXPERT_TIMEOUT_MS is invalid"); goto fail;
