+    else if (!strcmp(fallback, "local")) dispatch->fallback = FALLBACK_LOCAL;
+    else if (!strcmp(fallback, "alternate")) dispatch->fallback = FALLBACK_ALTERNATE;
+    else { dispatch_error(dispatch, "COLI_SWARM_EXPERT_FALLBACK is invalid"); goto fail; }
+    const char *response = getenv("COLI_SWARM_EXPERT_RESPONSE_MODE");
+    if (!response || !*response || !strcmp(response, "per_expert_exact")) dispatch->exact_response = 1;
+    else if (!strcmp(response, "per_worker_fast")) dispatch->exact_response = 0;
+    else { dispatch_error(dispatch, "COLI_SWARM_EXPERT_RESPONSE_MODE is invalid"); goto fail; }
+    const char *determinism = getenv("COLI_SWARM_EXPERT_DETERMINISM");
+    if (!determinism || !*determinism || !strcmp(determinism, "exact")) dispatch->exact_determinism = 1;
+    else if (!strcmp(determinism, "quality_bounded")) dispatch->exact_determinism = 0;
+    else { dispatch_error(dispatch, "COLI_SWARM_EXPERT_DETERMINISM is invalid"); goto fail; }
+    if (dispatch->exact_determinism && !dispatch->exact_response) {
+        dispatch_error(dispatch, "exact determinism requires per_expert_exact response mode"); goto fail;
+    }
+    const char *plan = getenv("COLI_SWARM_EXPERT_PLAN");
+    const char *telemetry = getenv("COLI_SWARM_EXPERT_TELEMETRY");
+    if (!absolute_path(plan) || !absolute_path(telemetry)) {
+        dispatch_error(dispatch, "external plan and telemetry paths must be absolute"); goto fail;
+    }
+    if (strlen(telemetry) >= sizeof(dispatch->telemetry_path)) {
+        dispatch_error(dispatch, "external telemetry path is too long"); goto fail;
+    }
+    strcpy(dispatch->telemetry_path, telemetry);
+    if ((size_t)n_layers > SIZE_MAX/(size_t)n_experts) {
+        dispatch_error(dispatch, "external ownership map overflows"); goto fail;
+    }
+    size_t owner_count = (size_t)n_layers * n_experts;
+    if (owner_count > SIZE_MAX/sizeof(int)) {
+        dispatch_error(dispatch, "external ownership map overflows"); goto fail;
+    }
+    dispatch->owners = malloc(owner_count * sizeof(int));
+    if (!dispatch->owners) { dispatch_error(dispatch, "out of memory allocating ownership map"); goto fail; }
+    for (size_t i = 0; i < owner_count; i++) dispatch->owners[i] = -1;
+    if (parse_plan(dispatch, plan) != 0) goto fail;
+    FILE *probe = fopen(dispatch->telemetry_path, "ab");
+    if (!probe) { dispatch_error(dispatch, "cannot open external telemetry path"); goto fail; }
+    fclose(probe); *out = dispatch; return 0;
+fail:
+    if (dispatch) {
+        fprintf(stderr, "external expert dispatch initialization failed: %s\n", dispatch->last_error);
+        olmoe_external_dispatch_close(dispatch);
+    }
+    return -1;
+}
+
+int olmoe_external_dispatch_enabled(const olmoe_external_dispatch *dispatch) {
+    return dispatch && dispatch->mode != MODE_LOCAL;
+}
+
+int olmoe_external_dispatch_is_remote(const olmoe_external_dispatch *dispatch,
+                                      int layer_id, int expert_id) {
+    if (!olmoe_external_dispatch_enabled(dispatch)) return 0;
+    return owner_index(dispatch, layer_id, expert_id) >= 0;
+}
+
+static void telemetry_event(olmoe_external_dispatch *dispatch, const char *event,
+        const char *request_id, int token_position, int layer_id, int batch_rows,
+        int worker_index, const int *ids, uint64_t bytes, uint64_t duration_ns,
+        const char *extra_name, const char *extra_value) {
+    FILE *file = fopen(dispatch->telemetry_path, "ab");
+    if (!file) return;
+    const char *worker = worker_index >= 0 ? dispatch->workers[worker_index].worker_id : "coordinator";
+    fprintf(file,
+        "{\"event\":\"%s\",\"request_id\":\"%s\",\"token_position\":%d,"
+        "\"layer_id\":%d,\"batch_rows\":%d,\"worker_id\":\"%s\","
+        "\"model_fingerprint\":\"%s\",\"expert_ids\":[",
+        event, request_id ? request_id : "", token_position, layer_id, batch_rows,
+        worker, dispatch->model_fingerprint);
+    int first = 1;
+    if (ids && worker_index >= 0) for (int row = 0; row < batch_rows; row++)
+        for (int rank = 0; rank < dispatch->top_k; rank++)
+            if (owner_index(dispatch, layer_id, ids[(size_t)row * dispatch->top_k + rank]) == worker_index) {
+                fprintf(file, "%s%d", first ? "" : ",", ids[(size_t)row * dispatch->top_k + rank]); first = 0;
+            }
+    fprintf(file, "],\"routing_rank\":["); first = 1;
+    if (ids && worker_index >= 0) for (int row = 0; row < batch_rows; row++)
+        for (int rank = 0; rank < dispatch->top_k; rank++)
+            if (owner_index(dispatch, layer_id, ids[(size_t)row * dispatch->top_k + rank]) == worker_index) {
+                fprintf(file, "%s%d", first ? "" : ",", rank); first = 0;
+            }
+    fprintf(file,
+        "],\"transport_codec\":\"raw_fp32\",\"evidence_category\":\"REAL_MODEL_MEASURED\","
+        "\"byte_count\":%llu,\"duration_ns\":%llu,\"expert_rpc_response_mode\":\"%s\"",
+        (unsigned long long)bytes, (unsigned long long)duration_ns,
+        dispatch->exact_response ? "per_expert_exact" : "per_worker_fast");
+    if (extra_name && extra_value) fprintf(file, ",\"%s\":%s", extra_name, extra_value);
+    fprintf(file, "}\n"); fclose(file);
+}
+
+static int ensure_connected(olmoe_external_dispatch *dispatch, int worker_index) {
+    dispatch_worker *worker = &dispatch->workers[worker_index];
+    if (worker->socket != OLMOE_INVALID_SOCKET) return 0;
+    char error[512] = {0};
+    if (olmoe_socket_connect(worker->host, worker->port, dispatch->timeout_ms,
+            &worker->socket, error, sizeof(error)) != 0)
+        return dispatch_error(dispatch, "%s", error);
+    return 0;
+}
+
+static int worker_is_selected(const olmoe_external_dispatch *dispatch, int worker,
+                              int layer, int rows, const int *ids) {
+    for (int row = 0; row < rows; row++) for (int rank = 0; rank < dispatch->top_k; rank++)
+        if (owner_index(dispatch, layer, ids[(size_t)row * dispatch->top_k + rank]) == worker) return 1;
+    return 0;
+}
+
+static int validate_route_coverage(olmoe_external_dispatch *dispatch, int layer,
+                                   int rows, const int *ids) {
+    for (int row = 0; row < rows; row++) for (int rank = 0; rank < dispatch->top_k; rank++) {
+        int expert = ids[(size_t)row * dispatch->top_k + rank]; int owner = owner_index(dispatch, layer, expert);
+        if (owner == -2 || (dispatch->mode == MODE_RPC && owner < 0))
+            return dispatch_error(dispatch, "selected expert has no permitted owner layer=%d expert=%d", layer, expert);
+    }
+    return 0;
+}
+
+int olmoe_external_dispatch_execute(olmoe_external_dispatch *dispatch,
+        int token_position, int layer_id, int batch_rows, const int *expert_ids_by_row,
+        const float *routing_weights_by_row, const float *activations,
+        float *per_rank_contributions, uint64_t *remote_result_count) {
+    if (!olmoe_external_dispatch_enabled(dispatch) || batch_rows < 1 || !expert_ids_by_row ||
+        !routing_weights_by_row || !activations || !per_rank_contributions)
+        return dispatch_error(dispatch, "invalid external dispatch request");
+    if (validate_route_coverage(dispatch, layer_id, batch_rows, expert_ids_by_row) != 0) return -1;
+    size_t contribution_values = (size_t)batch_rows * dispatch->top_k * dispatch->hidden_dim;
+    memset(per_rank_contributions, 0, contribution_values * sizeof(float));
+    uint64_t consumed = 0;
+    for (int wi = 0; wi < dispatch->n_workers; wi++) {
+        if (!worker_is_selected(dispatch, wi, layer_id, batch_rows, expert_ids_by_row)) continue;
+        char request_id[256];
+        snprintf(request_id, sizeof(request_id), "colibri-%llu-token-%d-layer-%d-worker-%d",
+                 (unsigned long long)++dispatch->request_counter, token_position, layer_id, wi);
+        swarm_expert_route_request request; memset(&request, 0, sizeof(request));
+        snprintf(request.request_id, sizeof(request.request_id), "%s", request_id);
+        snprintf(request.model_id, sizeof(request.model_id), "%s", dispatch->model_id);
+        snprintf(request.model_revision, sizeof(request.model_revision), "%s", dispatch->model_revision);
+        snprintf(request.quantization_fingerprint, sizeof(request.quantization_fingerprint), "%s", dispatch->quantization_fingerprint);
+        request.layer_id = layer_id; request.batch_rows = batch_rows;
+        request.latent_dimension = dispatch->hidden_dim; request.top_k = dispatch->top_k;
+        request.expert_ids_by_row = (int *)expert_ids_by_row;
+        request.routing_weights_by_row = (float *)routing_weights_by_row;
+        int *ranks = malloc((size_t)batch_rows * dispatch->top_k * sizeof(int));
+        if (!ranks) return dispatch_error(dispatch, "out of memory encoding route ranks");
+        for (int row = 0; row < batch_rows; row++) for (int rank = 0; rank < dispatch->top_k; rank++)
+            ranks[(size_t)row * dispatch->top_k + rank] = rank;
+        request.selected_rank_by_row = ranks;
+        request.response_mode = dispatch->exact_response ? SWARM_EXPERT_RESPONSE_PER_EXPERT_EXACT : SWARM_EXPERT_RESPONSE_PER_WORKER_FAST;
+        request.activation.values = activations; request.activation.token_position = token_position;
+        request.activation.route_generation = 0;
+        swarm_expert_owned_bytes encoded = {0}; char error[1024] = {0};
+        uint64_t deadline = monotonic_ns() + (uint64_t)dispatch->timeout_ms * 1000000ull;
+        int encode_rc = swarm_expert_wire_encode_route_request(&request, deadline,
+            "REAL_MODEL_MEASURED", dispatch->exact_determinism, &encoded, error, sizeof(error));
+        free(ranks);
+        if (encode_rc != 0) return dispatch_error(dispatch, "cannot encode expert request: %s", error);
+        telemetry_event(dispatch, "expert_rpc_request_started", request_id, token_position,
+                        layer_id, batch_rows, wi, expert_ids_by_row, encoded.length, 0, NULL, NULL);
+        uint64_t sent = 0, received = 0; uint64_t started = monotonic_ns();
+        if (ensure_connected(dispatch, wi) != 0 ||
+            olmoe_socket_send_frame(dispatch->workers[wi].socket, encoded.data, encoded.length,
+                                    &sent, error, sizeof(error)) != 0) {
+            olmoe_socket_close(dispatch->workers[wi].socket);
+            dispatch->workers[wi].socket = OLMOE_INVALID_SOCKET;
+            swarm_expert_wire_free_bytes(&encoded);
+            telemetry_event(dispatch, "expert_rpc_timeout", request_id, token_position, layer_id,
+                            batch_rows, wi, expert_ids_by_row, sent, monotonic_ns() - started, NULL, NULL);
+            return dispatch_error(dispatch, "expert worker send/connect failed: %s", error[0] ? error : dispatch->last_error);
+        }
+        swarm_expert_wire_free_bytes(&encoded); uint8_t *frame = NULL; size_t frame_length = 0;
+        if (olmoe_socket_receive_frame(dispatch->workers[wi].socket, &frame, &frame_length,
+                                      &received, error, sizeof(error)) != 0) {
+            olmoe_socket_close(dispatch->workers[wi].socket); dispatch->workers[wi].socket = OLMOE_INVALID_SOCKET;
+            telemetry_event(dispatch, "expert_rpc_timeout", request_id, token_position, layer_id,
+                            batch_rows, wi, expert_ids_by_row, received, monotonic_ns() - started, NULL, NULL);
+            return dispatch_error(dispatch, "expert worker receive failed: %s", error);
+        }
+        swarm_expert_route_response response;
+        if (swarm_expert_wire_decode_route_response(frame, frame_length, &response, error, sizeof(error)) != 0) {
+            free(frame); return dispatch_error(dispatch, "invalid expert response: %s", error);
+        }
+        if (strcmp(response.status, "ok") || strcmp(response.request_id, request_id) ||
+            strcmp(response.worker_id, dispatch->workers[wi].worker_id) ||
+            strcmp(response.model_revision, dispatch->model_revision) ||
+            strcmp(response.model_fingerprint, dispatch->model_fingerprint) ||
+            response.layer_id != layer_id) {
+            free(frame); return dispatch_error(dispatch, "expert response identity or status differs from request");
+        }
+        if (dispatch->exact_response) {
+            if (response.result.ndim != 3 || response.result.shape[0] != batch_rows ||
+                response.result.shape[1] != dispatch->top_k || response.result.shape[2] != dispatch->hidden_dim) {
+                free(frame); return dispatch_error(dispatch, "exact expert response has wrong shape");
+            }
+            for (int row = 0; row < batch_rows; row++) for (int rank = 0; rank < dispatch->top_k; rank++)
+                if (owner_index(dispatch, layer_id, expert_ids_by_row[(size_t)row * dispatch->top_k + rank]) == wi) {
+                    size_t at = ((size_t)row * dispatch->top_k + rank) * dispatch->hidden_dim;
+                    memcpy(per_rank_contributions + at, response.result.raw + at * sizeof(float),
+                           (size_t)dispatch->hidden_dim * sizeof(float)); consumed++;
+                }
+        } else {
+            if (response.result.ndim != 2 || response.result.shape[0] != batch_rows ||
+                response.result.shape[1] != dispatch->hidden_dim) {
+                free(frame); return dispatch_error(dispatch, "fast expert response has wrong shape");
+            }
+            for (int row = 0; row < batch_rows; row++) {
+                int first_rank = -1;
+                for (int rank = 0; rank < dispatch->top_k; rank++)
+                    if (owner_index(dispatch, layer_id, expert_ids_by_row[(size_t)row * dispatch->top_k + rank]) == wi) {
+                        if (first_rank < 0) first_rank = rank;
+                        consumed++;
+                    }
+                if (first_rank >= 0) {
+                    size_t destination = ((size_t)row * dispatch->top_k + first_rank) * dispatch->hidden_dim;
+                    memcpy(per_rank_contributions + destination,
+                           response.result.raw + (size_t)row * dispatch->hidden_dim * sizeof(float),
+                           (size_t)dispatch->hidden_dim * sizeof(float));
+                }
+            }
+        }
+        uint64_t elapsed = monotonic_ns() - started;
+        telemetry_event(dispatch, "expert_rpc_bytes_sent", request_id, token_position, layer_id,
+                        batch_rows, wi, expert_ids_by_row, sent, elapsed, NULL, NULL);
+        telemetry_event(dispatch, "expert_rpc_bytes_received", request_id, token_position, layer_id,
+                        batch_rows, wi, expert_ids_by_row, received, elapsed, NULL, NULL);
+        telemetry_event(dispatch, "expert_rpc_queue_ns", request_id, token_position, layer_id,
+                        batch_rows, wi, expert_ids_by_row, 0, response.queue_ns, NULL, NULL);
+        telemetry_event(dispatch, "expert_rpc_compute_ns", request_id, token_position, layer_id,
+                        batch_rows, wi, expert_ids_by_row, 0, response.compute_ns, NULL, NULL);
+        telemetry_event(dispatch, "expert_rpc_transport_ns", request_id, token_position, layer_id,
+                        batch_rows, wi, expert_ids_by_row, sent + received, elapsed, NULL, NULL);
+        telemetry_event(dispatch, "expert_rpc_request_completed", request_id, token_position,
+                        layer_id, batch_rows, wi, expert_ids_by_row, sent + received, elapsed,
+                        "remote_result_consumed", "true");
+        free(frame);
+    }
+    dispatch->consumed_remote_result_count += consumed;
+    if (remote_result_count) *remote_result_count = consumed;
+    return 0;
+}
+
+void olmoe_external_dispatch_forbidden_local_load(olmoe_external_dispatch *dispatch,
+        int token_position, int layer_id, int expert_id) {
+    if (!dispatch) return;
+    dispatch->forbidden_local_load_count++;
+    telemetry_event(dispatch, "forbidden_local_expert_load", "forbidden-local-load",
+                    token_position, layer_id, 1, -1, NULL, 0, 0,
+                    "forbidden_local_expert_load_count", "1");
+    FILE *file = fopen(dispatch->telemetry_path, "ab");
+    if (file) {
+        fprintf(file,
+            "{\"event\":\"forbidden_local_expert_load_detail\",\"request_id\":\"forbidden-local-load\","
+            "\"token_position\":%d,\"layer_id\":%d,\"batch_rows\":1,\"worker_id\":\"coordinator\","
+            "\"model_fingerprint\":\"%s\",\"expert_ids\":[%d],\"routing_rank\":[],"
+            "\"transport_codec\":\"raw_fp32\",\"evidence_category\":\"REAL_MODEL_MEASURED\"}\n",
+            token_position, layer_id, dispatch->model_fingerprint, expert_id);
+        fclose(file);
+    }
+}
+
+uint64_t olmoe_external_dispatch_forbidden_count(const olmoe_external_dispatch *dispatch) {
+    return dispatch ? dispatch->forbidden_local_load_count : 0;
+}
+
+uint64_t olmoe_external_dispatch_consumed_count(const olmoe_external_dispatch *dispatch) {
+    return dispatch ? dispatch->consumed_remote_result_count : 0;
+}
+
+void olmoe_external_dispatch_close(olmoe_external_dispatch *dispatch) {
+    if (!dispatch) return;
+    for (int i = 0; i < dispatch->n_workers; i++) olmoe_socket_close(dispatch->workers[i].socket);
+    free(dispatch->owners); free(dispatch);
+}
