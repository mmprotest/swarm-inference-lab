diff --git a/c/olmoe_expert_socket.c b/c/olmoe_expert_socket.c
new file mode 100644
index 0000000..8c01582
--- /dev/null
+++ b/c/olmoe_expert_socket.c
@@ -0,0 +1,269 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Shared portable socket transport for canonical length-framed SWARMEX1.
+ */
+#define _POSIX_C_SOURCE 200112L
+#include "olmoe_expert_socket.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "swarm_expert_wire.h"
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+typedef SOCKET native_socket;
+#define NATIVE_INVALID INVALID_SOCKET
+#define native_close closesocket
+#else
+#include <netdb.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+typedef int native_socket;
+#define NATIVE_INVALID (-1)
+#define native_close close
+#endif
+
+static int socket_error(char *error, size_t capacity, const char *fmt, ...) {
+    if (error && capacity) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(error, capacity, fmt, ap);
+        va_end(ap);
+    }
+    return -1;
+}
+
+static native_socket native(olmoe_socket socket) {
+    return (native_socket)(uintptr_t)socket;
+}
+
+static olmoe_socket portable(native_socket socket) {
+    return (olmoe_socket)(uintptr_t)socket;
+}
+
+int olmoe_socket_runtime_init(char *error, size_t error_capacity) {
+#ifdef _WIN32
+    static int initialized = 0;
+    if (!initialized) {
+        WSADATA data;
+        if (WSAStartup(MAKEWORD(2, 2), &data) != 0)
+            return socket_error(error, error_capacity, "WSAStartup failed");
+        initialized = 1;
+    }
+#else
+    (void)error;
+    (void)error_capacity;
+#endif
+    return 0;
+}
+
+int olmoe_socket_set_timeout(olmoe_socket socket, int timeout_ms,
+                             char *error, size_t error_capacity) {
+    if (socket == OLMOE_INVALID_SOCKET || timeout_ms < 1)
+        return socket_error(error, error_capacity, "invalid socket timeout");
+#ifdef _WIN32
+    DWORD timeout = (DWORD)timeout_ms;
+    if (setsockopt(native(socket), SOL_SOCKET, SO_RCVTIMEO,
+                   (const char *)&timeout, sizeof(timeout)) != 0 ||
+        setsockopt(native(socket), SOL_SOCKET, SO_SNDTIMEO,
+                   (const char *)&timeout, sizeof(timeout)) != 0)
+        return socket_error(error, error_capacity, "cannot set socket timeout");
+#else
+    struct timeval timeout = {timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+    if (setsockopt(native(socket), SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) != 0 ||
+        setsockopt(native(socket), SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)) != 0)
+        return socket_error(error, error_capacity, "cannot set socket timeout: %s", strerror(errno));
+#endif
+    return 0;
+}
+
+static int address_info(const char *host, int port, int passive,
+                        struct addrinfo **out, char *error, size_t error_capacity) {
+    char service[16];
+    if (!host || !*host || port < 0 || port > 65535)
+        return socket_error(error, error_capacity, "invalid TCP endpoint");
+    snprintf(service, sizeof(service), "%d", port);
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+    hints.ai_flags = passive ? AI_PASSIVE : 0;
+    int rc = getaddrinfo(host, service, &hints, out);
+    if (rc != 0)
+        return socket_error(error, error_capacity, "cannot resolve TCP endpoint: %s", gai_strerror(rc));
+    return 0;
+}
+
+int olmoe_socket_listen(const char *host, int port, int backlog,
+                        olmoe_socket *out, int *actual_port,
+                        char *error, size_t error_capacity) {
+    if (!out || !actual_port || backlog < 1 ||
+        olmoe_socket_runtime_init(error, error_capacity) != 0)
+        return -1;
+    *out = OLMOE_INVALID_SOCKET;
+    struct addrinfo *addresses = NULL;
+    if (address_info(host, port, 1, &addresses, error, error_capacity) != 0) return -1;
+    native_socket listener = NATIVE_INVALID;
+    for (struct addrinfo *item = addresses; item; item = item->ai_next) {
+        listener = socket(item->ai_family, item->ai_socktype, item->ai_protocol);
+        if (listener == NATIVE_INVALID) continue;
+        int reuse = 1;
+        setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, (const char *)&reuse, sizeof(reuse));
+        if (bind(listener, item->ai_addr, (int)item->ai_addrlen) == 0 &&
+            listen(listener, backlog) == 0) break;
+        native_close(listener);
+        listener = NATIVE_INVALID;
+    }
+    freeaddrinfo(addresses);
+    if (listener == NATIVE_INVALID)
+        return socket_error(error, error_capacity, "cannot bind or listen on TCP endpoint");
+    struct sockaddr_storage bound;
+#ifdef _WIN32
+    int bound_length = sizeof(bound);
+#else
+    socklen_t bound_length = sizeof(bound);
+#endif
+    if (getsockname(listener, (struct sockaddr *)&bound, &bound_length) != 0) {
+        native_close(listener);
+        return socket_error(error, error_capacity, "cannot inspect bound TCP endpoint");
+    }
+    if (bound.ss_family == AF_INET)
+        *actual_port = ntohs(((struct sockaddr_in *)&bound)->sin_port);
+    else if (bound.ss_family == AF_INET6)
+        *actual_port = ntohs(((struct sockaddr_in6 *)&bound)->sin6_port);
+    else {
+        native_close(listener);
+        return socket_error(error, error_capacity, "bound endpoint has unknown address family");
+    }
+    *out = portable(listener);
+    return 0;
+}
+
+int olmoe_socket_accept(olmoe_socket listener, olmoe_socket *out,
+                        char *error, size_t error_capacity) {
+    if (listener == OLMOE_INVALID_SOCKET || !out)
+        return socket_error(error, error_capacity, "invalid listener");
+    native_socket accepted = accept(native(listener), NULL, NULL);
+    if (accepted == NATIVE_INVALID)
+        return socket_error(error, error_capacity, "TCP accept failed");
+    *out = portable(accepted);
+    return 0;
+}
+
+int olmoe_socket_connect(const char *host, int port, int timeout_ms,
+                         olmoe_socket *out, char *error, size_t error_capacity) {
+    if (!out || olmoe_socket_runtime_init(error, error_capacity) != 0) return -1;
+    *out = OLMOE_INVALID_SOCKET;
+    struct addrinfo *addresses = NULL;
+    if (address_info(host, port, 0, &addresses, error, error_capacity) != 0) return -1;
+    native_socket connected = NATIVE_INVALID;
+    for (struct addrinfo *item = addresses; item; item = item->ai_next) {
+        connected = socket(item->ai_family, item->ai_socktype, item->ai_protocol);
+        if (connected == NATIVE_INVALID) continue;
+        olmoe_socket candidate = portable(connected);
+        if (olmoe_socket_set_timeout(candidate, timeout_ms, error, error_capacity) == 0 &&
+            connect(connected, item->ai_addr, (int)item->ai_addrlen) == 0) break;
+        native_close(connected);
+        connected = NATIVE_INVALID;
+    }
+    freeaddrinfo(addresses);
+    if (connected == NATIVE_INVALID)
+        return socket_error(error, error_capacity, "cannot connect to expert worker %s:%d", host, port);
+    *out = portable(connected);
+    return 0;
+}
+
+static int send_all(native_socket socket, const uint8_t *data, size_t length) {
+    while (length) {
+        int amount = length > INT_MAX ? INT_MAX : (int)length;
+        int sent = send(socket, (const char *)data, amount, 0);
+        if (sent <= 0) return -1;
+        data += sent;
+        length -= (size_t)sent;
+    }
+    return 0;
+}
+
+static int receive_all(native_socket socket, uint8_t *data, size_t length) {
+    while (length) {
+        int amount = length > INT_MAX ? INT_MAX : (int)length;
+        int received = recv(socket, (char *)data, amount, 0);
+        if (received <= 0) return -1;
+        data += received;
+        length -= (size_t)received;
+    }
+    return 0;
+}
+
+int olmoe_socket_send_bytes(olmoe_socket socket, const uint8_t *data,
+                            size_t length, char *error, size_t error_capacity) {
+    if (socket == OLMOE_INVALID_SOCKET || (!data && length) ||
+        send_all(native(socket), data, length) != 0)
+        return socket_error(error, error_capacity, "socket byte send failed");
+    return 0;
+}
+
+int olmoe_socket_receive_bytes(olmoe_socket socket, uint8_t *data,
+                               size_t length, char *error, size_t error_capacity) {
+    if (socket == OLMOE_INVALID_SOCKET || (!data && length) ||
+        receive_all(native(socket), data, length) != 0)
+        return socket_error(error, error_capacity, "socket byte receive failed");
+    return 0;
+}
+
+int olmoe_socket_send_frame(olmoe_socket socket, const uint8_t *payload,
+                            size_t payload_length, uint64_t *wire_bytes,
+                            char *error, size_t error_capacity) {
+    if (socket == OLMOE_INVALID_SOCKET || !payload || payload_length > SWARM_EXPERT_MAX_FRAME_BYTES)
+        return socket_error(error, error_capacity, "invalid expert socket frame");
+    uint8_t length[8];
+    uint64_t value = payload_length;
+    for (int i = 7; i >= 0; i--) { length[i] = (uint8_t)value; value >>= 8; }
+    if (send_all(native(socket), length, sizeof(length)) != 0 ||
+        send_all(native(socket), payload, payload_length) != 0)
+        return socket_error(error, error_capacity, "expert socket send failed");
+    if (wire_bytes) *wire_bytes = payload_length + sizeof(length);
+    return 0;
+}
+
+int olmoe_socket_receive_frame(olmoe_socket socket, uint8_t **payload,
+                               size_t *payload_length, uint64_t *wire_bytes,
+                               char *error, size_t error_capacity) {
+    if (socket == OLMOE_INVALID_SOCKET || !payload || !payload_length)
+        return socket_error(error, error_capacity, "invalid expert socket receive argument");
+    *payload = NULL;
+    *payload_length = 0;
+    uint8_t encoded[8];
+    if (receive_all(native(socket), encoded, sizeof(encoded)) != 0)
+        return socket_error(error, error_capacity, "expert socket length receive failed");
+    uint64_t length = 0;
+    for (int i = 0; i < 8; i++) length = (length << 8) | encoded[i];
+    if (length > SWARM_EXPERT_MAX_FRAME_BYTES || length > SIZE_MAX)
+        return socket_error(error, error_capacity, "expert socket frame is too large");
+    uint8_t *frame = (uint8_t *)malloc((size_t)length ? (size_t)length : 1);
+    if (!frame) return socket_error(error, error_capacity, "out of memory receiving expert frame");
+    if (length && receive_all(native(socket), frame, (size_t)length) != 0) {
+        free(frame);
+        return socket_error(error, error_capacity, "expert socket payload receive failed");
+    }
+    *payload = frame;
+    *payload_length = (size_t)length;
+    if (wire_bytes) *wire_bytes = length + sizeof(encoded);
+    return 0;
+}
+
+void olmoe_socket_close(olmoe_socket socket) {
+    if (socket != OLMOE_INVALID_SOCKET) native_close(native(socket));
+}
