+    snprintf(dispatch->model_id, sizeof(dispatch->model_id), "colibri-olmoe");
+    snprintf(dispatch->model_revision, sizeof(dispatch->model_revision), "pinned-b085b48888a88d9a1c00b151a9979774b72cdbfd");
