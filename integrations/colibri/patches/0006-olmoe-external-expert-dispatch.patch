+}
+
+static int control_send(olmoe_socket socket, const char *json) {
+    size_t length = strlen(json); if (length > UINT32_MAX) return -1;
+    uint8_t prefix[4] = {(uint8_t)(length >> 24), (uint8_t)(length >> 16),
