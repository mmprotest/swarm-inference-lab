+}
+
+static char *control_receive(olmoe_socket socket) {
+    uint8_t prefix[4]; char error[256];
+    if (olmoe_socket_receive_bytes(socket, prefix, sizeof(prefix), error, sizeof(error)) != 0) return NULL;
+    uint32_t length = ((uint32_t)prefix[0] << 24) | ((uint32_t)prefix[1] << 16) |
+                      ((uint32_t)prefix[2] << 8) | prefix[3];
+    if (length > 512u * 1024u * 1024u) return NULL;
+    char *json = malloc((size_t)length + 1); if (!json) return NULL;
+    if (olmoe_socket_receive_bytes(socket, (uint8_t *)json, length, error, sizeof(error)) != 0) {
+        free(json); return NULL;
+    }
