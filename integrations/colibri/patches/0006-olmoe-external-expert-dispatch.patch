+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * External expert dispatch after native routing and before residual addition.
+ * Router logits, weights, ranks, tokenizer, and sampler are not modified.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include "olmoe_external_dispatch.h"
+
+#include <errno.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "json.h"
+#include "olmoe_expert_socket.h"
+#include "swarm_expert_wire.h"
+
+#define OLMOE_MAX_WORKERS 256
+
+typedef enum { MODE_LOCAL, MODE_RPC, MODE_HYBRID, MODE_PLANNER } dispatch_mode;
+typedef enum { FALLBACK_FAIL, FALLBACK_LOCAL, FALLBACK_ALTERNATE } fallback_mode;
+
+typedef struct {
+    char worker_id[256];
+    char host[256];
+    int port;
+    olmoe_socket socket;
+} dispatch_worker;
+
+struct olmoe_external_dispatch {
+    dispatch_mode mode;
+    fallback_mode fallback;
+    int exact_response;
+    int exact_determinism;
+    int timeout_ms;
+    int hidden_dim, intermediate_dim, n_layers, n_experts, top_k;
+    char model_id[256];
+    char model_revision[256];
+    char model_fingerprint[256];
+    char quantization_fingerprint[256];
+    char phase[32];
+    char telemetry_path[2048];
+    dispatch_worker workers[OLMOE_MAX_WORKERS];
+    int n_workers;
+    int *owners;
+    uint64_t request_counter;
+    uint64_t forbidden_local_load_count;
+    uint64_t consumed_remote_result_count;
+    char last_error[1024];
+};
+
+static uint64_t monotonic_ns(void) {
+    struct timespec value;
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    return (uint64_t)value.tv_sec * 1000000000ull + (uint64_t)value.tv_nsec;
+}
+
+static int dispatch_error(olmoe_external_dispatch *dispatch, const char *fmt, ...) {
+    if (dispatch) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(dispatch->last_error, sizeof(dispatch->last_error), fmt, ap);
+        va_end(ap);
+    }
+    return -1;
+}
+
+const char *olmoe_external_dispatch_last_error(const olmoe_external_dispatch *dispatch) {
+    return dispatch ? dispatch->last_error : "external dispatch is null";
+}
+
+static char *read_text(const char *path, size_t limit) {
+    FILE *file = fopen(path, "rb");
+    if (!file) return NULL;
+    if (fseek(file, 0, SEEK_END) != 0) { fclose(file); return NULL; }
+    long length = ftell(file);
+    if (length < 0 || (size_t)length > limit || fseek(file, 0, SEEK_SET) != 0) {
+        fclose(file); return NULL;
+    }
+    char *value = (char *)malloc((size_t)length + 1);
+    if (!value) { fclose(file); return NULL; }
+    if (fread(value, 1, (size_t)length, file) != (size_t)length) {
+        free(value); fclose(file); return NULL;
+    }
+    fclose(file); value[length] = 0; return value;
+}
+
+static int json_int_field(jval *object, const char *name, int *out) {
+    jval *value = json_get(object, name);
+    if (!value || value->t != J_NUM || value->num < 0 || value->num > 2147483647.0)
+        return -1;
+    int converted = (int)value->num;
+    if ((double)converted != value->num) return -1;
+    *out = converted; return 0;
+}
+
+static const char *json_string_field(jval *object, const char *name) {
+    jval *value = json_get(object, name);
+    return value && value->t == J_STR ? value->str : NULL;
+}
+
+static int copy_field(char *out, size_t capacity, jval *object, const char *name) {
+    const char *value = json_string_field(object, name);
+    if (!value || !*value || strlen(value) >= capacity) return -1;
+    strcpy(out, value); return 0;
+}
+
+static int parse_endpoint(const char *endpoint, char host[256], int *port) {
+    if (!endpoint) return -1;
+    if (!strncmp(endpoint, "tcp://", 6)) endpoint += 6;
+    const char *separator = strrchr(endpoint, ':');
+    if (!separator || separator == endpoint || strlen(endpoint) >= 320) return -1;
+    size_t host_length = (size_t)(separator - endpoint);
+    if (host_length >= 256) return -1;
+    if (endpoint[0] == '[' && separator > endpoint + 1 && separator[-1] == ']') {
+        endpoint++; host_length -= 2;
+    }
+    memcpy(host, endpoint, host_length); host[host_length] = 0;
+    char *end = NULL; errno = 0; long parsed = strtol(separator + 1, &end, 10);
+    if (errno || !end || *end || parsed < 1 || parsed > 65535) return -1;
+    *port = (int)parsed; return 0;
+}
+
+static int owner_index(const olmoe_external_dispatch *dispatch, int layer, int expert) {
+    if (!dispatch || layer < 0 || layer >= dispatch->n_layers ||
+        expert < 0 || expert >= dispatch->n_experts) return -2;
+    return dispatch->owners[(size_t)layer * dispatch->n_experts + expert];
+}
+
+static int assign_owner(olmoe_external_dispatch *dispatch, int layer, int expert, int worker) {
+    if (layer < 0 || layer >= dispatch->n_layers || expert < 0 || expert >= dispatch->n_experts)
+        return dispatch_error(dispatch, "ownership entry layer=%d expert=%d is outside model dimensions", layer, expert);
+    int *slot = &dispatch->owners[(size_t)layer * dispatch->n_experts + expert];
+    if (*slot != -1)
+        return dispatch_error(dispatch, "duplicate ownership for layer=%d expert=%d", layer, expert);
+    *slot = worker; return 0;
+}
+
+static int parse_ownership_list(olmoe_external_dispatch *dispatch, jval *array, int worker) {
+    if (!array) return 0;
+    if (array->t != J_ARR) return dispatch_error(dispatch, "owned_experts must be an array");
+    for (int i = 0; i < array->len; i++) {
+        int layer, expert; jval *item = array->kids[i];
+        if (!item || item->t != J_OBJ || json_int_field(item, "layer_id", &layer) != 0 ||
+            json_int_field(item, "expert_id", &expert) != 0 ||
+            assign_owner(dispatch, layer, expert, worker) != 0) return -1;
+    }
+    return 0;
+}
+
+static int parse_plan(olmoe_external_dispatch *dispatch, const char *path) {
+    char *text = read_text(path, 64u << 20);
+    if (!text) return dispatch_error(dispatch, "cannot read external expert plan %s", path);
+    char *arena = NULL; jval *root = json_parse(text, &arena); int rc = -1;
+    const char *schema = json_string_field(root, "schema_version");
+    jval *workers = json_get(root, "workers");
+    if (!root || root->t != J_OBJ || !schema || strcmp(schema, "1.0") ||
+        copy_field(dispatch->model_fingerprint, sizeof(dispatch->model_fingerprint), root, "model_fingerprint") != 0 ||
+        copy_field(dispatch->quantization_fingerprint, sizeof(dispatch->quantization_fingerprint), root, "quantization_fingerprint") != 0 ||
+        copy_field(dispatch->phase, sizeof(dispatch->phase), root, "phase") != 0 ||
+        !workers || workers->t != J_ARR || workers->len < 1 || workers->len > OLMOE_MAX_WORKERS) {
+        dispatch_error(dispatch, "external expert plan schema or identity is invalid"); goto done;
+    }
+    dispatch->n_workers = workers->len;
+    for (int i = 0; i < workers->len; i++) {
+        jval *worker = workers->kids[i]; const char *endpoint;
+        if (!worker || worker->t != J_OBJ ||
+            copy_field(dispatch->workers[i].worker_id, sizeof(dispatch->workers[i].worker_id), worker, "worker_id") != 0 ||
+            !(endpoint = json_string_field(worker, "endpoint")) ||
+            parse_endpoint(endpoint, dispatch->workers[i].host, &dispatch->workers[i].port) != 0 ||
+            parse_ownership_list(dispatch, json_get(worker, "owned_experts"), i) != 0) {
+            if (!dispatch->last_error[0]) dispatch_error(dispatch, "worker %d in external plan is invalid", i);
+            goto done;
+        }
+        dispatch->workers[i].socket = OLMOE_INVALID_SOCKET;
+    }
+    if (parse_ownership_list(dispatch, json_get(root, "local_experts"), -1) != 0) goto done;
+    if (dispatch->mode == MODE_RPC) {
+        size_t count = (size_t)dispatch->n_layers * dispatch->n_experts;
+        for (size_t i = 0; i < count; i++) if (dispatch->owners[i] < 0) {
+            dispatch_error(dispatch, "rpc mode requires remote ownership for every routed expert"); goto done;
+        }
+    }
+    rc = 0;
+done:
+    free(text); free(arena); return rc;
+}
+
+static int absolute_path(const char *path) {
+    if (!path || !*path) return 0;
+#ifdef _WIN32
+    return (strlen(path) > 2 && ((path[0] >= 'A' && path[0] <= 'Z') ||
+            (path[0] >= 'a' && path[0] <= 'z')) && path[1] == ':' &&
+            (path[2] == '\\' || path[2] == '/')) ||
+           (path[0] == '\\' && path[1] == '\\');
+#else
+    return path[0] == '/';
+#endif
+}
+
+static int parse_positive_env(const char *name, int fallback, int maximum, int *out) {
+    const char *value = getenv(name);
+    if (!value || !*value) { *out = fallback; return 0; }
+    char *end = NULL; errno = 0; long parsed = strtol(value, &end, 10);
+    if (errno || !end || *end || parsed < 1 || parsed > maximum) return -1;
+    *out = (int)parsed; return 0;
+}
+
+int olmoe_external_dispatch_open(const char *model_path, int hidden_dim,
