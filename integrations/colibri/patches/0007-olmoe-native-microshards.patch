 c/olmoe_expert_runtime.h            |  22 +++
 c/olmoe_expert_worker.c             |  48 +++++-
 c/olmoe_external_dispatch.c         | 250 +++++++++++++++++++++++++---
 c/tests/test_olmoe_expert_runtime.c |  36 ++++
 5 files changed, 410 insertions(+), 31 deletions(-)

diff --git a/c/olmoe_expert_runtime.c b/c/olmoe_expert_runtime.c
index 8b0d558..dbd5594 100644
--- a/c/olmoe_expert_runtime.c
+++ b/c/olmoe_expert_runtime.c
@@ -342,8 +342,9 @@ static inline int32_t runtime_dot_i8_16(const int8_t *a, const int8_t *b) {
