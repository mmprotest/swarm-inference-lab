+static int append_microshard(olmoe_external_dispatch *dispatch,
+        int worker, int layer, int expert, int start, int end) {
+    if (worker < 0 || worker >= dispatch->n_workers || layer < 0 ||
+        layer >= dispatch->n_layers || expert < 0 || expert >= dispatch->n_experts ||
+        start < 0 || end <= start || end > dispatch->intermediate_dim)
+        return dispatch_error(dispatch, "microshard ownership is outside model dimensions");
+    if (owner_index(dispatch, layer, expert) >= 0)
+        return dispatch_error(dispatch, "expert layer=%d expert=%d mixes whole and microshard ownership",
+                              layer, expert);
+    dispatch_worker *owner = &dispatch->workers[worker];
+    if (owner->execution_kind == 1)
+        return dispatch_error(dispatch, "worker %s mixes whole experts and microshards",
+                              owner->worker_id);
+    if (owner->execution_kind == 2 &&
+        (owner->hidden_start != start || owner->hidden_end != end))
+        return dispatch_error(dispatch,
+            "worker %s has non-uniform microshard ranges; canonical coalescing needs one range per worker",
+            owner->worker_id);
+    owner->execution_kind = 2; owner->hidden_start = start; owner->hidden_end = end;
+    for (size_t i = 0; i < dispatch->n_microshards; i++) {
+        dispatch_microshard *prior = &dispatch->microshards[i];
+        if (prior->layer_id == layer && prior->expert_id == expert &&
+            start < prior->hidden_end && prior->hidden_start < end)
+            return dispatch_error(dispatch,
+                "overlapping microshard ownership layer=%d expert=%d ranges=%d:%d and %d:%d",
+                layer, expert, prior->hidden_start, prior->hidden_end, start, end);
+    }
+    if (dispatch->n_microshards == dispatch->microshard_capacity) {
+        size_t capacity = dispatch->microshard_capacity ? dispatch->microshard_capacity * 2 : 1024;
+        if (capacity > SIZE_MAX / sizeof(*dispatch->microshards))
+            return dispatch_error(dispatch, "microshard ownership allocation overflows");
+        dispatch_microshard *grown = realloc(dispatch->microshards,
+            capacity * sizeof(*dispatch->microshards));
+        if (!grown) return dispatch_error(dispatch, "out of memory parsing microshard ownership");
+        dispatch->microshards = grown; dispatch->microshard_capacity = capacity;
+    }
+    dispatch->microshards[dispatch->n_microshards++] =
+        (dispatch_microshard){layer, expert, start, end, worker};
+    return 0;
+}
+
+static int parse_microshard_list(olmoe_external_dispatch *dispatch, jval *array, int worker) {
+    if (!array) return 0;
+    if (array->t != J_ARR) return dispatch_error(dispatch, "owned_microshards must be an array");
+    for (int i = 0; i < array->len; i++) {
+        int layer, expert, start, end; jval *item = array->kids[i];
+        if (!item || item->t != J_OBJ ||
+            json_int_field(item, "layer_id", &layer) != 0 ||
+            json_int_field(item, "expert_id", &expert) != 0 ||
+            json_int_field(item, "hidden_start", &start) != 0 ||
+            json_int_field(item, "hidden_end", &end) != 0 ||
+            append_microshard(dispatch, worker, layer, expert, start, end) != 0)
+            return -1;
+    }
+    return 0;
+}
+
+static int microshard_owner(const olmoe_external_dispatch *dispatch,
+        int worker, int layer, int expert, int *start, int *end) {
+    for (size_t i = 0; i < dispatch->n_microshards; i++) {
+        const dispatch_microshard *grant = &dispatch->microshards[i];
+        if (grant->worker_index == worker && grant->layer_id == layer &&
+            grant->expert_id == expert) {
+            if (start) *start = grant->hidden_start;
+            if (end) *end = grant->hidden_end;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int microshard_coverage(const olmoe_external_dispatch *dispatch,
+        int layer, int expert) {
+    int cursor = 0;
+    while (cursor < dispatch->intermediate_dim) {
+        const dispatch_microshard *next = NULL;
+        for (size_t i = 0; i < dispatch->n_microshards; i++) {
+            const dispatch_microshard *grant = &dispatch->microshards[i];
+            if (grant->layer_id == layer && grant->expert_id == expert &&
+                grant->hidden_start == cursor) { next = grant; break; }
+        }
+        if (!next) return 0;
+        cursor = next->hidden_end;
+    }
+    return cursor == dispatch->intermediate_dim;
+}
