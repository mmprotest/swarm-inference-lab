 }
 
+int olmoe_expert_runtime_execute_microshard_chain(olmoe_expert_runtime *r,
+        const olmoe_expert_request *request, const olmoe_expert_slice *slice,
+        const float *down_accumulators, int final_slice, float *per_expert_outputs) {
+    if (validate_request(r, request) != 0 || !slice || !per_expert_outputs ||
+        slice->layer_id != request->layer_id ||
+        final_slice != (slice->hidden_end == r->intermediate_dim))
+        return runtime_error(r, "invalid exact native microshard chain request");
+    int D = r->hidden_dim, width = slice->hidden_end - slice->hidden_start;
+    if (slice->hidden_start && !down_accumulators)
+        return runtime_error(r, "non-initial native microshard has no down accumulator");
+    olmoe_native_expert_view view; int8_t *weights = NULL; float *scales = NULL;
+    if (load_native_slice(r, slice, &view, &weights, &scales) != 0) return -1;
+    float *workspace = malloc((size_t)width * 2 * sizeof(float));
+    if (!workspace) {
+        free(weights); free(scales);
+        return runtime_error(r, "out of memory chaining native microshard");
+    }
+    size_t values = (size_t)request->batch_rows * request->top_k * D;
+    if (down_accumulators) memcpy(per_expert_outputs, down_accumulators, values * sizeof(float));
+    else memset(per_expert_outputs, 0, values * sizeof(float));
+    for (int row = 0; row < request->batch_rows; row++) {
+        const float *activation = request->activations + (int64_t)row * D;
+        for (int rank = 0; rank < request->top_k; rank++) {
+            int at = row * request->top_k + rank;
+            if (request->expert_ids[at] != slice->expert_id) continue;
+            const float *seed = down_accumulators
+                ? down_accumulators + (int64_t)at * D : NULL;
+            float *out = per_expert_outputs + (int64_t)at * D;
+            if (olmoe_expert_runtime_execute_view_microshard_chain_with_workspace(
+                    &view, activation, seed, final_slice, out,
+                    workspace, workspace + width) != 0) {
+                free(workspace); free(weights); free(scales);
+                return runtime_error(r, "exact native microshard chain execution failed");
+            }
+        }
+    }
+    free(workspace); free(weights); free(scales); return 0;
+}
+
 int olmoe_expert_runtime_execute_microshards(olmoe_expert_runtime *r,
         const olmoe_expert_request *request, const olmoe_expert_slice *slices,
         int n_slices, float *partial_output) {
