--- /dev/null
+++ b/c/olmoe_memory_residency.c
@@ -0,0 +1,153 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Read-only process/system residency telemetry.  No execution decision is
+ * derived in this module and no model tensor is modified.
+ */
+#include "olmoe_memory_residency.h"
+
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <psapi.h>
+#else
+#include <sys/resource.h>
+#if defined(__linux__)
+#include <sys/sysinfo.h>
+#include <unistd.h>
+#endif
+#endif
+
+static uint64_t multiply_saturating(uint64_t left, uint64_t right) {
+    if (left && right > UINT64_MAX / left) return UINT64_MAX;
+    return left * right;
+}
+
+int olmoe_memory_snapshot_current(olmoe_memory_snapshot *out) {
+    if (!out) return -1;
+    memset(out, 0, sizeof(*out));
+#ifdef _WIN32
+    PROCESS_MEMORY_COUNTERS_EX process;
+    memset(&process, 0, sizeof(process));
+    process.cb = sizeof(process);
+    if (GetProcessMemoryInfo(GetCurrentProcess(),
+            (PROCESS_MEMORY_COUNTERS *)&process, sizeof(process))) {
+        out->working_set_bytes = (uint64_t)process.WorkingSetSize;
+        out->peak_working_set_bytes = (uint64_t)process.PeakWorkingSetSize;
+        out->private_bytes = (uint64_t)process.PrivateUsage;
+        out->commit_size_bytes = (uint64_t)process.PagefileUsage;
+        out->pagefile_usage_bytes = (uint64_t)process.PagefileUsage;
+        out->page_fault_count = (uint64_t)process.PageFaultCount;
+        out->process_counters_available = 1;
+    }
+    IO_COUNTERS io;
+    if (GetProcessIoCounters(GetCurrentProcess(), &io)) {
+        out->process_io_read_bytes = (uint64_t)io.ReadTransferCount;
+        out->process_io_write_bytes = (uint64_t)io.WriteTransferCount;
+        out->process_io_read_operations = (uint64_t)io.ReadOperationCount;
+        out->process_io_write_operations = (uint64_t)io.WriteOperationCount;
+    }
+    PERFORMANCE_INFORMATION performance;
+    memset(&performance, 0, sizeof(performance));
+    performance.cb = sizeof(performance);
+    if (GetPerformanceInfo(&performance, sizeof(performance))) {
+        uint64_t page = (uint64_t)performance.PageSize;
+        out->system_commit_limit_bytes = multiply_saturating(
+            (uint64_t)performance.CommitLimit, page);
+        out->system_committed_bytes = multiply_saturating(
+            (uint64_t)performance.CommitTotal, page);
+        out->available_physical_bytes = multiply_saturating(
+            (uint64_t)performance.PhysicalAvailable, page);
+        out->system_counters_available = 1;
+    }
+    MEMORYSTATUSEX memory;
+    memset(&memory, 0, sizeof(memory));
+    memory.dwLength = sizeof(memory);
+    if (GlobalMemoryStatusEx(&memory)) {
+        out->available_physical_bytes = (uint64_t)memory.ullAvailPhys;
+        out->system_counters_available = 1;
+    }
+    /* GetProcessMemoryInfo exposes total process pagefile-backed commit, not
+     * pagefile read traffic or the compressed-store share.  Keep the explicit
+     * availability flags false rather than reporting invented zero metrics. */
+    return out->process_counters_available || out->system_counters_available ? 0 : -1;
+#else
+    struct rusage usage;
+    if (getrusage(RUSAGE_SELF, &usage) == 0) {
+#if defined(__APPLE__)
+        out->peak_working_set_bytes = (uint64_t)usage.ru_maxrss;
+#else
+        out->peak_working_set_bytes = multiply_saturating((uint64_t)usage.ru_maxrss, 1024);
+#endif
+        out->page_fault_count = (uint64_t)usage.ru_minflt + (uint64_t)usage.ru_majflt;
+        out->process_counters_available = 1;
+    }
+#if defined(__linux__)
+    struct sysinfo information;
+    if (sysinfo(&information) == 0) {
+        uint64_t unit = information.mem_unit ? (uint64_t)information.mem_unit : 1;
+        out->available_physical_bytes = multiply_saturating(
+            (uint64_t)information.freeram, unit);
+        out->system_commit_limit_bytes = multiply_saturating(
+            (uint64_t)information.totalram + (uint64_t)information.totalswap, unit);
+        out->system_counters_available = 1;
+    }
+#endif
+    return out->process_counters_available || out->system_counters_available ? 0 : -1;
+#endif
+}
+
+int olmoe_memory_estimate_resident_bytes(const void *address, size_t length,
+        size_t max_samples, uint64_t *resident_bytes, uint64_t *sampled_pages,
+        uint64_t *resident_pages, int *supported) {
+    if (!resident_bytes || !sampled_pages || !resident_pages || !supported)
+        return -1;
+    *resident_bytes = 0; *sampled_pages = 0; *resident_pages = 0; *supported = 0;
+    if (!address || !length) return 0;
+#ifdef _WIN32
+    SYSTEM_INFO system;
+    GetSystemInfo(&system);
+    size_t page = system.dwPageSize ? (size_t)system.dwPageSize : 4096;
+    uintptr_t first = (uintptr_t)address & ~((uintptr_t)page - 1u);
+    uintptr_t last_byte = (uintptr_t)address + length - 1u;
+    if (last_byte < (uintptr_t)address) return -1;
+    uintptr_t last = last_byte & ~((uintptr_t)page - 1u);
+    uint64_t total_pages = ((uint64_t)(last - first) / page) + 1u;
+    uint64_t samples = total_pages;
+    if (max_samples && samples > max_samples) samples = max_samples;
+    if (!samples || samples > SIZE_MAX / sizeof(PSAPI_WORKING_SET_EX_INFORMATION))
+        return -1;
+    PSAPI_WORKING_SET_EX_INFORMATION *query = calloc(
+        (size_t)samples, sizeof(*query));
+    if (!query) return -1;
+    for (uint64_t i = 0; i < samples; i++) {
+        uint64_t page_index = samples == total_pages ? i
+            : (samples == 1 ? 0 : (i * (total_pages - 1u)) / (samples - 1u));
+        query[i].VirtualAddress = (void *)(first + (uintptr_t)page_index * page);
+    }
+    if (!QueryWorkingSetEx(GetCurrentProcess(), query,
+            (DWORD)(samples * sizeof(*query)))) {
+        free(query); return -1;
+    }
+    uint64_t resident = 0;
+    for (uint64_t i = 0; i < samples; i++)
+        if (query[i].VirtualAttributes.Valid) resident++;
+    free(query);
+    *sampled_pages = samples; *resident_pages = resident; *supported = 1;
+    if (resident == samples) *resident_bytes = (uint64_t)length;
+    else if (resident)
+        *resident_bytes = (uint64_t)((long double)length * resident / samples);
+    return 0;
+#else
+    (void)max_samples;
+    return 0;
+#endif
+}
diff --git a/c/olmoe_memory_residency.h b/c/olmoe_memory_residency.h
new file mode 100644
index 0000000..8004f15
--- /dev/null
+++ b/c/olmoe_memory_residency.h
@@ -0,0 +1,61 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Process/system memory-residency observations.  This file is telemetry only;
+ * it does not alter model arithmetic, routing, tensor bytes, or sampling.
+ */
+#ifndef OLMOE_MEMORY_RESIDENCY_H
+#define OLMOE_MEMORY_RESIDENCY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    uint64_t working_set_bytes;
+    uint64_t peak_working_set_bytes;
+    uint64_t private_bytes;
+    uint64_t commit_size_bytes;
+    uint64_t page_fault_count;
+    uint64_t process_io_read_bytes;
+    uint64_t process_io_write_bytes;
+    uint64_t process_io_read_operations;
+    uint64_t process_io_write_operations;
+    uint64_t system_commit_limit_bytes;
+    uint64_t system_committed_bytes;
+    uint64_t available_physical_bytes;
+    uint64_t pagefile_usage_bytes;
+    uint64_t memory_compression_bytes;
+    int process_counters_available;
+    int system_counters_available;
+    int pagefile_read_bytes_available;
+    int memory_compression_available;
+} olmoe_memory_snapshot;
+
+/* Capture the current process plus system-wide commit/physical counters. */
+int olmoe_memory_snapshot_current(olmoe_memory_snapshot *out);
+
+/* Estimate resident bytes for an allocation by sampling at most max_samples
+ * pages with QueryWorkingSetEx on Windows.  sampled_pages/resident_pages are
+ * exact for the sampled addresses; resident_bytes is the corresponding
+ * proportional estimate for the complete byte range.  Other platforms return
+ * supported=0 rather than manufacturing a value. */
+int olmoe_memory_estimate_resident_bytes(
+    const void *address,
+    size_t length,
+    size_t max_samples,
+    uint64_t *resident_bytes,
+    uint64_t *sampled_pages,
+    uint64_t *resident_pages,
+    int *supported
+);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/c/tests/test_olmoe_expert_shm.c b/c/tests/test_olmoe_expert_shm.c
