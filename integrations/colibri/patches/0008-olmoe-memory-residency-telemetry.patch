+static int validate_response(olmoe_external_dispatch *dispatch, int worker_index,
+        const char *request_id, int layer_id, int batch_rows,
+        const uint8_t *frame, size_t frame_length,
+        swarm_expert_route_response *response, char *error,
+        size_t error_capacity) {
+    if (swarm_expert_wire_decode_route_response(frame, frame_length, response,
+            error, error_capacity) != 0) return -1;
+    if (strcmp(response->status, "ok") || strcmp(response->request_id, request_id) ||
+        strcmp(response->worker_id, dispatch->workers[worker_index].worker_id) ||
+        strcmp(response->model_revision, dispatch->model_revision) ||
+        strcmp(response->model_fingerprint, dispatch->model_fingerprint) ||
+        response->layer_id != layer_id) {
+        snprintf(error, error_capacity,
+                 "expert response identity or status differs from request");
+        return -1;
+    }
+    if (dispatch->exact_response) {
+        if (response->result.ndim != 3 ||
+            response->result.shape[0] != batch_rows ||
+            response->result.shape[1] != dispatch->top_k ||
+            response->result.shape[2] != dispatch->hidden_dim) {
+            snprintf(error, error_capacity,
+                     "exact expert response has wrong shape");
+            return -1;
+        }
+    } else if (response->result.ndim != 2 ||
+               response->result.shape[0] != batch_rows ||
+               response->result.shape[1] != dispatch->hidden_dim) {
+        snprintf(error, error_capacity,
+                 "fast expert response has wrong shape");
+        return -1;
+    }
+    return 0;
+}
+
+static int responses_equal(const swarm_expert_route_response *left,
+                           const swarm_expert_route_response *right) {
+    if (left->result.ndim != right->result.ndim ||
+        left->result.raw_length != right->result.raw_length) return 0;
+    for (int i = 0; i < left->result.ndim; i++)
+        if (left->result.shape[i] != right->result.shape[i]) return 0;
+    return !memcmp(left->result.raw, right->result.raw,
+                   left->result.raw_length);
+}
