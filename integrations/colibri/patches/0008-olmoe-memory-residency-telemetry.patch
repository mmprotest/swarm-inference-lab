+        if (result_values) result[result_values / 2] = -result[result_values / 2] + 0.25f;
+        applied = CORRUPTION_WRONG_EXPERT;
+    } else if (!strcmp(snapshot.kind, "wrong_layer_id")) {
+        applied = CORRUPTION_WRONG_LAYER;
+    } else if (!strcmp(snapshot.kind, "wrong_model_revision")) {
+        applied = CORRUPTION_WRONG_REVISION;
+    } else if (!strcmp(snapshot.kind, "lower_precision_result")) {
+        for (size_t i = 0; i < result_values; i++) {
+            uint32_t bits;
