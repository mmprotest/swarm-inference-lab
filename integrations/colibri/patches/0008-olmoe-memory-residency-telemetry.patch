+static int dispatch_round_trip(olmoe_external_dispatch *dispatch, int worker_index,
+        const swarm_expert_owned_bytes *encoded, int batch_rows,
+        uint8_t **frame, size_t *frame_length, uint64_t *sent,
+        uint64_t *received, char *error, size_t error_capacity) {
+    *frame = NULL; *frame_length = 0; *sent = *received = 0;
+    int rc = 0;
+    if (dispatch->data_plane == DATA_SHARED_MEMORY) {
+        rc = shared_memory_round_trip(dispatch, worker_index, encoded, batch_rows,
+            frame, frame_length, sent, received, error, error_capacity);
+    } else if (ensure_connected(dispatch, worker_index) != 0 ||
+        olmoe_socket_send_frame(dispatch->workers[worker_index].socket,
+            encoded->data, encoded->length, sent, error, error_capacity) != 0 ||
+        olmoe_socket_receive_frame(dispatch->workers[worker_index].socket,
+            frame, frame_length, received, error, error_capacity) != 0) {
+        rc = -1;
+    }
+    if (rc != 0) {
+        olmoe_socket_close(dispatch->workers[worker_index].socket);
+        dispatch->workers[worker_index].socket = OLMOE_INVALID_SOCKET;
+        free(*frame); *frame = NULL; *frame_length = 0;
+    }
+    return rc;
+}
