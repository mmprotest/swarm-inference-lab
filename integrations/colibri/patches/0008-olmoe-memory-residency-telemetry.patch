+    free(arena); swarm_expert_wire_free_packet(&ack); free(ack_bytes);
+    swarm_expert_wire_free_bytes(&control);
+    olmoe_shared_memory_close(&destination); olmoe_shared_memory_close(&source);
+    return rc;
+}
