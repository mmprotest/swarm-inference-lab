@@ -0,0 +1,171 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Process-shared byte buffers used by the canonical SWARMEX1 data plane.
+ */
+#define _POSIX_C_SOURCE 200809L
+#include "olmoe_expert_shm.h"
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+static int shm_error(char *error, size_t capacity, const char *fmt, ...) {
+    if (error && capacity) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(error, capacity, fmt, ap);
+        va_end(ap);
+    }
+    return -1;
+}
+
+static unsigned long process_id(void) {
+#ifdef _WIN32
+    return (unsigned long)GetCurrentProcessId();
+#else
+    return (unsigned long)getpid();
+#endif
+}
+
+static uint64_t next_identity(void) {
+    static uint64_t counter = 0;
+    struct timespec value;
+    clock_gettime(CLOCK_MONOTONIC, &value);
+    uint64_t clock_part = (uint64_t)value.tv_sec * 1000000000ull +
+                          (uint64_t)value.tv_nsec;
+#if defined(__GNUC__) || defined(__clang__)
+    uint64_t sequence = __atomic_add_fetch(&counter, 1, __ATOMIC_RELAXED);
+#else
+    uint64_t sequence = ++counter;
+#endif
+    return clock_part ^ (sequence * 0x9e3779b97f4a7c15ull);
+}
+
+static int safe_name(const char *name) {
+    if (!name || !*name || strlen(name) >= 128) return 0;
+    for (const unsigned char *p = (const unsigned char *)name; *p; p++)
+        if (!( (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+               (*p >= '0' && *p <= '9') || *p == '_' || *p == '-')) return 0;
+    return 1;
+}
+
+int olmoe_shared_memory_create(const char *purpose, size_t size,
+                               olmoe_shared_memory *out,
+                               char *error, size_t error_capacity) {
+    if (!out || !purpose || !safe_name(purpose) || size < 1)
+        return shm_error(error, error_capacity, "invalid shared-memory create request");
+    memset(out, 0, sizeof(*out));
+    out->handle = -1;
+    snprintf(out->name, sizeof(out->name), "coli_swarm_%s_%lu_%016llx",
+             purpose, process_id(), (unsigned long long)next_identity());
+#ifdef _WIN32
+    DWORD high = (DWORD)(((uint64_t)size) >> 32);
+    DWORD low = (DWORD)((uint64_t)size & 0xffffffffu);
+    HANDLE mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                        high, low, out->name);
+    if (!mapping || GetLastError() == ERROR_ALREADY_EXISTS) {
+        if (mapping) CloseHandle(mapping);
+        return shm_error(error, error_capacity, "cannot create unique shared-memory mapping");
+    }
+    void *address = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size);
+    if (!address) {
+        CloseHandle(mapping);
+        return shm_error(error, error_capacity, "cannot map shared-memory buffer");
+    }
+    out->handle = (intptr_t)mapping;
+#else
+    char system_name[132];
+    snprintf(system_name, sizeof(system_name), "/%s", out->name);
+    int descriptor = shm_open(system_name, O_RDWR | O_CREAT | O_EXCL, 0600);
+    if (descriptor < 0 || ftruncate(descriptor, (off_t)size) != 0) {
+        if (descriptor >= 0) { close(descriptor); shm_unlink(system_name); }
+        return shm_error(error, error_capacity, "cannot create shared-memory object: %s", strerror(errno));
+    }
+    void *address = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0);
+    if (address == MAP_FAILED) {
+        close(descriptor); shm_unlink(system_name);
+        return shm_error(error, error_capacity, "cannot map shared-memory object: %s", strerror(errno));
+    }
+    out->handle = (intptr_t)descriptor;
+#endif
+    out->address = address;
+    out->size = size;
+    out->owner = 1;
+    return 0;
+}
+
+int olmoe_shared_memory_open(const char *name, size_t size,
+                             olmoe_shared_memory *out,
+                             char *error, size_t error_capacity) {
+    if (!out || !safe_name(name) || size < 1)
+        return shm_error(error, error_capacity, "invalid shared-memory open request");
+    memset(out, 0, sizeof(*out));
+    out->handle = -1;
+    snprintf(out->name, sizeof(out->name), "%s", name);
+#ifdef _WIN32
+    HANDLE mapping = OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, name);
+    if (!mapping)
+        return shm_error(error, error_capacity, "cannot open shared-memory mapping");
+    void *address = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size);
+    if (!address) {
+        CloseHandle(mapping);
+        return shm_error(error, error_capacity, "cannot map shared-memory buffer");
+    }
+    out->handle = (intptr_t)mapping;
+#else
+    char system_name[132];
+    snprintf(system_name, sizeof(system_name), "/%s", name);
+    int descriptor = shm_open(system_name, O_RDWR, 0600);
+    if (descriptor < 0)
+        return shm_error(error, error_capacity, "cannot open shared-memory object: %s", strerror(errno));
+    struct stat status;
+    if (fstat(descriptor, &status) != 0 || status.st_size < 0 ||
+        (uint64_t)status.st_size < (uint64_t)size) {
+        close(descriptor);
+        return shm_error(error, error_capacity, "shared-memory object is smaller than declared");
+    }
+    void *address = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0);
+    if (address == MAP_FAILED) {
+        close(descriptor);
+        return shm_error(error, error_capacity, "cannot map shared-memory object: %s", strerror(errno));
+    }
+    out->handle = (intptr_t)descriptor;
+#endif
+    out->address = address;
+    out->size = size;
+    return 0;
+}
+
+void olmoe_shared_memory_close(olmoe_shared_memory *mapping) {
+    if (!mapping) return;
+#ifdef _WIN32
+    if (mapping->address) UnmapViewOfFile(mapping->address);
+    if (mapping->handle != -1) CloseHandle((HANDLE)mapping->handle);
+#else
+    if (mapping->address && mapping->size) munmap(mapping->address, mapping->size);
+    if (mapping->handle != -1) close((int)mapping->handle);
+    if (mapping->owner && mapping->name[0]) {
+        char system_name[132];
+        snprintf(system_name, sizeof(system_name), "/%s", mapping->name);
+        shm_unlink(system_name);
+    }
+#endif
+    memset(mapping, 0, sizeof(*mapping));
+    mapping->handle = -1;
+}
