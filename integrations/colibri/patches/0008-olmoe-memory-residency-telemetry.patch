+        return dispatch_error(dispatch,
+            "hidden challenge requires an explicit whole-expert replica");
+    size_t activation_values = (size_t)batch_rows * dispatch->hidden_dim;
+    size_t route_values = (size_t)batch_rows * dispatch->top_k;
+    float *challenge_activation = malloc(activation_values * sizeof(float));
+    int *challenge_ranks = malloc(route_values * sizeof(int));
+    if (!challenge_activation || !challenge_ranks) {
+        free(challenge_activation); free(challenge_ranks);
+        return dispatch_error(dispatch,
+            "out of memory building hidden challenge activation");
+    }
+    memcpy(challenge_activation, activations,
+           activation_values * sizeof(float));
+    for (int row = 0; row < batch_rows; row++) {
+        size_t at = (size_t)row * dispatch->hidden_dim +
+            (dispatch->request_counter + (uint64_t)row) %
+                (uint64_t)dispatch->hidden_dim;
+        challenge_activation[at] += 0.03125f;
+    }
+    for (size_t i = 0; i < route_values; i++)
+        challenge_ranks[i] = (int)(i % (size_t)dispatch->top_k);
+    swarm_expert_route_request challenge = *original;
+    snprintf(challenge.request_id, sizeof(challenge.request_id),
+             "%s%schallenge-%llu-token-%d-layer-%d-worker-%d",
+             dispatch->request_namespace,
+             dispatch->request_namespace[0] ? "-" : "",
+             (unsigned long long)dispatch->request_counter,
+             token_position, layer_id, primary);
+    challenge.activation.values = challenge_activation;
+    challenge.activation.route_generation = 1;
+    challenge.selected_rank_by_row = challenge_ranks;
+    challenge.challenge = 1;
+    challenge.down_accumulators.values = NULL;
+    challenge.down_accumulators.value_count = 0;
+    swarm_expert_owned_bytes encoded = {0};
+    uint64_t deadline = monotonic_ns() +
+        (uint64_t)dispatch->timeout_ms * 1000000ull;
+    int rc = swarm_expert_wire_encode_route_request(&challenge, deadline,
+        "REAL_MODEL_MEASURED", 1, &encoded, error, error_capacity);
+    free(challenge_activation); free(challenge_ranks);
+    if (rc != 0) return dispatch_error(dispatch,
+        "cannot encode hidden challenge request: %s", error);
+    telemetry_event(dispatch, "expert_rpc_hidden_challenge_started",
+        challenge.request_id, token_position, layer_id, batch_rows, primary,
+        expert_ids_by_row, encoded.length, 0, "parent_request_id_present", "true");
+    uint8_t *primary_frame = NULL, *alternate_frame = NULL;
+    size_t primary_length = 0, alternate_length = 0;
+    uint64_t primary_sent = 0, primary_received = 0;
+    uint64_t alternate_sent = 0, alternate_received = 0;
+    swarm_expert_route_response primary_response, alternate_response;
+    memset(&primary_response, 0, sizeof(primary_response));
+    memset(&alternate_response, 0, sizeof(alternate_response));
+    uint64_t started = monotonic_ns();
+    rc = dispatch_round_trip(dispatch, primary, &encoded, batch_rows,
+        &primary_frame, &primary_length, &primary_sent, &primary_received,
+        error, error_capacity);
+    if (rc == 0) rc = validate_response(dispatch, primary,
+        challenge.request_id, layer_id, batch_rows, primary_frame,
+        primary_length, &primary_response, error, error_capacity);
+    if (rc == 0) rc = dispatch_round_trip(dispatch, alternate, &encoded,
+        batch_rows, &alternate_frame, &alternate_length, &alternate_sent,
+        &alternate_received, error, error_capacity);
+    if (rc == 0) rc = validate_response(dispatch, alternate,
+        challenge.request_id, layer_id, batch_rows, alternate_frame,
+        alternate_length, &alternate_response, error, error_capacity);
+    if (rc != 0) {
+        free(primary_frame); free(alternate_frame);
+        swarm_expert_wire_free_bytes(&encoded);
+        return dispatch_error(dispatch,
+            "hidden challenge transport or validation failed: %s", error);
+    }
+    dispatch->duplicate_verification_count++;
+    if (!responses_equal(&primary_response, &alternate_response)) {
+        mark_integrity_failure(dispatch, primary, challenge.request_id,
+            token_position, layer_id, batch_rows, expert_ids_by_row,
+            "\"hidden_challenge_activation\"");
+        telemetry_event(dispatch, "expert_rpc_hidden_challenge_detected",
+            challenge.request_id, token_position, layer_id, batch_rows,
+            primary, expert_ids_by_row,
+            primary_sent + primary_received + alternate_sent + alternate_received,
+            monotonic_ns() - started, "parent_request_id_present", "true");
+        rc = 1;
+    } else {
+        dispatch->clean_verification_count++;
+        telemetry_event(dispatch, "expert_rpc_hidden_challenge_passed",
+            challenge.request_id, token_position, layer_id, batch_rows,
+            primary, expert_ids_by_row,
+            primary_sent + primary_received + alternate_sent + alternate_received,
+            monotonic_ns() - started, "false_positive", "false");
+        rc = 0;
+    }
+    free(primary_frame); free(alternate_frame);
+    swarm_expert_wire_free_bytes(&encoded);
+    (void)parent_request_id;
+    return rc;
+}
