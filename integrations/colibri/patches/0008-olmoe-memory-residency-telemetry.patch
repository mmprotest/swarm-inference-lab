+typedef struct {
+    olmoe_external_dispatch *dispatch;
+    int worker_index;
+    const swarm_expert_owned_bytes *encoded;
+    int batch_rows;
+    int delay_ms;
+    uint8_t *frame;
+    size_t frame_length;
+    uint64_t sent;
+    uint64_t received;
+    char error[1024];
+    int rc;
+} hedge_round_trip_context;
+
+static void *hedge_round_trip_thread(void *argument) {
+    hedge_round_trip_context *context = argument;
+    sleep_milliseconds(context->delay_ms);
+    context->rc = dispatch_round_trip(context->dispatch,
+        context->worker_index, context->encoded, context->batch_rows,
+        &context->frame, &context->frame_length, &context->sent,
+        &context->received, context->error, sizeof(context->error));
+    return NULL;
+}
