+/* SWARM 010 DOWNSTREAM MODIFICATION (Apache-2.0): optional numeric trace.
+ *
+ * Official local-versus-RPC correctness runs need errors at every real MoE
+ * boundary and before every greedy sample.  COLI_SWARM_NUMERIC_TRACE writes
+ * the exact in-engine FP32 values without changing the router, weights, or
+ * sampler.  Records are deliberately small and language-neutral:
+ *
+ *   magic[8]="COLNUM1\0", u32 kind, i32 token, i32 layer,
+ *   i32 rows, i32 width, u64 payload_bytes, float32 payload[]
+ *
+ * kind 1 is the post-MoE residual boundary, kind 2 is the pre-sampling
+ * logits row, and kind 3 is the router's exact selected-weight matrix.
+ */
+static FILE *swarm_numeric_trace_file;
+static int swarm_numeric_trace_open_attempted;
+
+static void swarm_numeric_trace_write(
+        uint32_t kind, int token_position, int layer_id,
+        int rows, int width, const float *values) {
+    const char magic[8] = {'C','O','L','N','U','M','1','\0'};
+    if (!swarm_numeric_trace_open_attempted) {
+        const char *path = getenv("COLI_SWARM_NUMERIC_TRACE");
+        swarm_numeric_trace_open_attempted = 1;
+        if (path && *path) {
+            swarm_numeric_trace_file = fopen(path, "wb");
+            if (!swarm_numeric_trace_file) {
+                fprintf(stderr, "cannot open COLI_SWARM_NUMERIC_TRACE=%s\n", path);
+                exit(1);
+            }
+        }
+    }
+    if (!swarm_numeric_trace_file) return;
+    if (rows <= 0 || width <= 0 || !values ||
+            (uint64_t)rows > UINT64_MAX / (uint64_t)width / sizeof(float)) {
+        fprintf(stderr, "invalid numeric trace record geometry\n");
+        exit(1);
+    }
+    int32_t token = token_position, layer = layer_id;
+    int32_t row_count = rows, value_width = width;
+    uint64_t payload_bytes = (uint64_t)rows * (uint64_t)width * sizeof(float);
+    if (fwrite(magic, 1, sizeof(magic), swarm_numeric_trace_file) != sizeof(magic) ||
+            fwrite(&kind, sizeof(kind), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(&token, sizeof(token), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(&layer, sizeof(layer), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(&row_count, sizeof(row_count), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(&value_width, sizeof(value_width), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(&payload_bytes, sizeof(payload_bytes), 1, swarm_numeric_trace_file) != 1 ||
+            fwrite(values, 1, (size_t)payload_bytes, swarm_numeric_trace_file) != payload_bytes) {
+        fprintf(stderr, "failed to write COLI_SWARM_NUMERIC_TRACE record\n");
+        exit(1);
+    }
+}
