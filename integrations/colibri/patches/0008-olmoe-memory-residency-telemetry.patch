@@ -0,0 +1,39 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification test for swarm-inference-lab Experiment 010.
+ */
+#include "../olmoe_expert_shm.h"
+
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+    char error[256] = {0};
+    olmoe_shared_memory owner = {.handle = -1};
+    olmoe_shared_memory peer = {.handle = -1};
+    if (olmoe_shared_memory_create("test", 4096, &owner,
+            error, sizeof(error)) != 0) {
+        fprintf(stderr, "create failed: %s\n", error); return 1;
+    }
+    memset(owner.address, 0x5a, owner.size);
+    if (olmoe_shared_memory_open(owner.name, owner.size, &peer,
+            error, sizeof(error)) != 0) {
+        fprintf(stderr, "open failed: %s\n", error);
+        olmoe_shared_memory_close(&owner); return 2;
+    }
+    const unsigned char *bytes = peer.address;
+    for (size_t i = 0; i < peer.size; i++) if (bytes[i] != 0x5a) {
+        fprintf(stderr, "shared byte differs at %llu\n", (unsigned long long)i);
+        olmoe_shared_memory_close(&peer); olmoe_shared_memory_close(&owner); return 3;
+    }
+    ((unsigned char *)peer.address)[17] = 0xa5;
+    if (((unsigned char *)owner.address)[17] != 0xa5) {
+        fprintf(stderr, "shared write was not visible to owner\n");
+        olmoe_shared_memory_close(&peer); olmoe_shared_memory_close(&owner); return 4;
+    }
+    olmoe_shared_memory_close(&peer); olmoe_shared_memory_close(&owner);
+    puts("olmoe shared-memory transport test passed");
+    return 0;
+}
