diff --git a/c/tests/test_olmoe_memory_residency.c b/c/tests/test_olmoe_memory_residency.c
new file mode 100644
index 0000000..6f314bc
--- /dev/null
+++ b/c/tests/test_olmoe_memory_residency.c
@@ -0,0 +1,37 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ * Downstream Experiment 010 test for read-only memory residency telemetry.
+ */
+#include "../olmoe_memory_residency.h"
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+int main(void) {
+    olmoe_memory_snapshot before, after;
+    assert(olmoe_memory_snapshot_current(&before) == 0);
+    size_t length = 8u * 1024u * 1024u;
+    uint8_t *allocation = (uint8_t *)malloc(length);
+    assert(allocation);
+    for (size_t i = 0; i < length; i += 4096) allocation[i] = (uint8_t)i;
+    assert(olmoe_memory_snapshot_current(&after) == 0);
+    assert(after.process_counters_available);
+    assert(after.page_fault_count >= before.page_fault_count);
+    uint64_t bytes, sampled, resident; int supported;
+    assert(olmoe_memory_estimate_resident_bytes(allocation, length, 64,
+        &bytes, &sampled, &resident, &supported) == 0);
+#ifdef _WIN32
+    assert(supported);
+    assert(sampled > 0 && sampled <= 64);
+    assert(resident > 0 && resident <= sampled);
+    assert(bytes > 0 && bytes <= length);
+    assert(!after.pagefile_read_bytes_available);
+    assert(!after.memory_compression_available);
+#else
+    assert(!supported);
+#endif
+    free(allocation);
+    return 0;
+}
