+static int execute_hidden_challenge(olmoe_external_dispatch *dispatch,
+        int primary, int alternate, const swarm_expert_route_request *original,
+        const float *activations, const int *expert_ids_by_row,
+        int token_position, int layer_id, int batch_rows,
+        const char *parent_request_id, char *error, size_t error_capacity) {
