diff --git a/c/swarm_bridge.py b/c/swarm_bridge.py
new file mode 100644
index 0000000..c4f08f2
--- /dev/null
+++ b/c/swarm_bridge.py
@@ -0,0 +1,183 @@
+"""Optional, semantics-neutral NDJSON bridge for swarm-inference-lab.
+
+SWARM BRIDGE PATCH: this file is downstream integration code. It observes the
+existing engine protocol only; it never changes model inputs, routing, sampling,
+weights, quantization, or mathematical operations.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from pathlib import Path
+
+
+EVENT_TYPES = frozenset(
+    {
+        "engine_started",
+        "engine_ready",
+        "engine_stopped",
+        "capability_report",
+        "model_inventory",
+        "tensor_inventory",
+        "tier_inventory",
+        "placement_plan",
+        "request_started",
+        "prefill_started",
+        "prefill_completed",
+        "decode_token_started",
+        "decode_token_completed",
+        "request_completed",
+        "route_summary",
+        "route_event",
+        "expert_cache_hit",
+        "expert_cache_miss",
+        "expert_prefetch_started",
+        "expert_prefetch_completed",
+        "expert_loaded",
+        "expert_promoted",
+        "expert_demoted",
+        "expert_evicted",
+        "storage_read",
+        "host_to_device_transfer",
+        "device_to_host_transfer",
+        "cpu_compute",
+        "gpu_compute",
+        "resource_snapshot",
+        "warning",
+        "error",
+    }
+)
+LEVELS = {"off": 0, "summary": 1, "detailed": 2, "trace": 3}
+EVENT_LEVEL = {
+    "decode_token_started": 2,
+    "decode_token_completed": 2,
+    "route_event": 3,
+    "expert_cache_hit": 2,
+    "expert_cache_miss": 2,
+    "expert_prefetch_started": 2,
+    "expert_prefetch_completed": 2,
+    "expert_loaded": 2,
+    "expert_promoted": 2,
+    "expert_demoted": 2,
+    "expert_evicted": 2,
+    "storage_read": 2,
+    "host_to_device_transfer": 2,
+    "device_to_host_transfer": 2,
+    "cpu_compute": 2,
+    "gpu_compute": 2,
+}
+
+
+class SwarmBridge:
+    """Thread-safe event writer and request phase tracker."""
+
+    version = "1.0"
+
+    def __init__(self, model, engine_family, environment=None):
+        env = environment or os.environ
+        self.enabled = env.get("COLI_SWARM_BRIDGE") == "1"
+        self.level = env.get("COLI_SWARM_TELEMETRY", "summary").lower()
+        if self.level not in LEVELS:
+            raise ValueError("COLI_SWARM_TELEMETRY must be off, summary, detailed, or trace")
+        if self.level == "off":
+            self.enabled = False
+        self.model_id = env.get("COLI_MODEL_ID", Path(model).name)
+        self.model_revision = env.get("COLI_MODEL_REVISION", "")
+        self.engine_family = engine_family
+        self.engine_pid = 0
+        self.sequence = 0
+        self.lock = threading.Lock()
+        self.requests = {}
+        self.handle = None
+        self.path = None
+        if self.enabled:
+            selected = env.get("COLI_SWARM_BRIDGE_PATH")
+            self.path = Path(selected) if selected else Path(model) / ".coli_swarm_telemetry.ndjson"
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            self.handle = self.path.open("a", encoding="utf-8", buffering=1)
+
+    def emit(self, event_type, payload=None, request_id=None):
+        if event_type not in EVENT_TYPES:
+            raise ValueError(f"unknown swarm bridge event type: {event_type}")
+        if not self.enabled or LEVELS[self.level] < EVENT_LEVEL.get(event_type, 1):
+            return
+        with self.lock:
+            event = {
+                "schema_version": "1.0",
+                "event_type": event_type,
+                "timestamp_ns": time.time_ns(),
+                "engine_pid": self.engine_pid,
+                "request_id": None if request_id is None else str(request_id),
+                "model_id": self.model_id,
+                "model_revision": self.model_revision,
+                "engine_family": self.engine_family,
+                "sequence_number": self.sequence,
+                "payload": dict(payload or {}),
+            }
+            self.sequence += 1
+            self.handle.write(json.dumps(event, ensure_ascii=False, separators=(",", ":")) + "\n")
+            self.handle.flush()
+
+    def engine_started(self, pid, executable):
+        self.engine_pid = int(pid)
+        self.emit(
+            "engine_started",
+            {"bridge_version": self.version, "telemetry_level": self.level, "executable": str(executable)},
+        )
+
+    def engine_ready(self):
+        self.emit("engine_ready", {})
+
+    def request_started(self, request_id, maximum, cache_slot, prompt_bytes):
+        self.requests[str(request_id)] = {"prefill_completed": False, "tokens": 0}
+        self.emit(
+            "request_started",
+            {"max_tokens": maximum, "cache_slot": cache_slot, "prompt_bytes": prompt_bytes},
+            request_id,
+        )
+
+    def prompt_tokens(self, request_id, token_ids):
+        state = self.requests.setdefault(str(request_id), {"prefill_completed": False, "tokens": 0})
+        state["input_token_ids"] = list(token_ids)
+
+    def prefill_started(self, request_id, prompt_tokens):
+        state = self.requests.setdefault(str(request_id), {"prefill_completed": False, "tokens": 0})
+        state["prompt_tokens"] = prompt_tokens
+        payload = {"prompt_tokens": prompt_tokens}
+        if LEVELS[self.level] >= LEVELS["detailed"]:
+            payload["input_token_ids"] = state.get("input_token_ids", [])
+        self.emit("prefill_started", payload, request_id)
+
+    def token(self, request_id, token_id):
+        state = self.requests.setdefault(str(request_id), {"prefill_completed": False, "tokens": 0})
+        if not state["prefill_completed"]:
+            state["prefill_completed"] = True
+            self.emit("prefill_completed", {"prompt_tokens": state.get("prompt_tokens")}, request_id)
+        position = state["tokens"]
+        self.emit("decode_token_started", {"token_position": position}, request_id)
+        state["tokens"] += 1
+        self.emit(
+            "decode_token_completed",
+            {"token_position": position, "token_id": int(token_id)},
+            request_id,
+        )
+
+    def request_completed(self, request_id, stats):
+        state = self.requests.pop(str(request_id), {})
+        if not state.get("prefill_completed"):
+            self.emit("prefill_completed", {"prompt_tokens": state.get("prompt_tokens")}, request_id)
+        payload = dict(stats)
+        payload["observed_token_count"] = state.get("tokens", 0)
+        self.emit("request_completed", payload, request_id)
+
+    def close(self, exit_code=None):
+        if not self.enabled:
+            return
+        self.emit("engine_stopped", {"exit_code": exit_code})
+        with self.lock:
+            self.handle.close()
+            self.handle = None
+            self.enabled = False
