+        exit(1);
+    }
+    int rd, ri, rl, re;
+    olmoe_expert_runtime_dimensions(m->expert_runtime, &rd, &ri, &rl, &re);
+    if (rd != m->c.hidden || ri != m->c.inter ||
+        rl != m->c.n_layers || re != m->c.n_experts) {
+        fprintf(stderr, "shared OLMoE expert runtime dimensions differ from model config\n");
+        exit(1);
+    }
     Cfg *c = &m->c;
     rt_init("olmoe", c->n_layers, c->n_experts);
     const char *usage_override = getenv("COLI_USAGE_PATH");
@@ -585,35 +524,19 @@ static void slot_ensure_allocated(Model *m, Slot *s) {
 }
 
 static void load_expert_merged(Model *m, int layer, int eid, Slot *s, int prefetched) {
-    char nm[256], qsnm[256];
-    snprintf(nm, sizeof(nm), "model.layers.%d.mlp.experts.%d.merged_weight", layer, eid);
-    snprintf(qsnm, sizeof(qsnm), "model.layers.%d.mlp.experts.%d.qs", layer, eid);
-    /* SEC: st_init skips its numel*esz==nbytes cross-check for dtype-3 (U8/I8)
-     * tensors, so a crafted header from an untrusted mirror can declare nbytes
-     * far larger than the config-sized destination and st_read_raw would write
-     * past w_block (heap overflow); an oversized .qs likewise overruns s->gs.
-     * slot_ensure_allocated sizes those buffers exactly ng+ng+nd bytes and
-     * inter+inter+hidden floats, so require an exact match. Reject, never
-     * repair — same contract as qt_resolve_fmt in the GLM engine. */
-    Cfg *cc = &m->c;
-    int64_t ng = (int64_t)cc->inter * cc->hidden, nd = (int64_t)cc->hidden * cc->inter;
-    int64_t want_w = ng + ng + nd;
-    int64_t want_s = (int64_t)cc->inter + cc->inter + cc->hidden;
-    st_tensor *tw = st_find(&m->S, nm), *ts = st_find(&m->S, qsnm);
-    if (!tw || tw->nbytes != want_w) {
-        fprintf(stderr, "%s: expert weight is %lld bytes — expected %lld for [inter=%d,hidden=%d], "
-                "refusing (untrusted container)\n", nm, (long long)(tw ? tw->nbytes : -1),
-                (long long)want_w, cc->inter, cc->hidden); exit(1); }
-    if (!ts || ts->numel != want_s) {
-        fprintf(stderr, "%s: scale array is %lld elems — expected %lld, refusing (untrusted container)\n",
-                qsnm, (long long)(ts ? ts->numel : -1), (long long)want_s); exit(1); }
     double read_started = now_s();
-    st_read_raw(&m->S, nm, s->g, g_expert_drop);
-    st_read_f32(&m->S, qsnm, s->gs, 0);  /* scales are F32; use typed reader for dtype safety */
+    uint64_t bytes_read = 0;
+    if (olmoe_expert_runtime_load_into(m->expert_runtime, layer, eid,
+                                      s->g, s->gs, g_expert_drop,
+                                      &bytes_read) != 0) {
+        fprintf(stderr, "shared expert load failed for layer=%d expert=%d: %s\n",
+                layer, eid, olmoe_expert_runtime_last_error(m->expert_runtime));
+        exit(1);
+    }
     double read_elapsed = now_s() - read_started;
     pthread_mutex_lock(&g_pilot_mx);
     m->storage_read_count++;
-    m->storage_read_bytes += (uint64_t)tw->nbytes + (uint64_t)ts->nbytes;
+    m->storage_read_bytes += bytes_read;
     m->storage_read_s += read_elapsed;
     if (prefetched) m->prefetch_loads++; else m->demand_loads++;
     s->prefetched = prefetched;
@@ -860,13 +783,17 @@ static void moe(Model *m, Layer *l, int layer, float *x, int S, float *out) {
         for (int kk = 0; kk < K; kk++) {
             Slot *e; expert_get(m, layer, idx[kk], &e);
             double expert_compute_started = now_s();
-            matmul_q(g, xs, e->g, e->gs, D, I);     /* gate_proj [I,D] */
-            matmul_q(u, xs, e->u, e->us, D, I);     /* up_proj   [I,D] */
-            for (int i = 0; i < I; i++) { float gv = g[i]; g[i] = (gv / (1.f + expf(-gv))) * u[i]; }
-            matmul_q(hh, g, e->d, e->ds, I, D);     /* down_proj [D,I] */
-            float w = val[kk];
             float *os = out + (int64_t)s*D;
-            for (int d = 0; d < D; d++) os[d] += w * hh[d];
+            olmoe_native_expert_view view = {
+                layer, idx[kk], D, I, 0, I,
+                e->g, e->u, e->d, e->gs, e->us, e->ds
+            };
+            if (olmoe_expert_runtime_accumulate_view_with_workspace(
+                    &view, xs, val[kk], os, g, u, hh) != 0) {
+                fprintf(stderr, "shared expert execution failed at layer=%d expert=%d\n",
+                        layer, idx[kk]);
+                exit(1);
+            }
             m->cpu_expert_s += now_s() - expert_compute_started;
         }
     }
diff --git a/c/olmoe_expert_runtime.c b/c/olmoe_expert_runtime.c
new file mode 100644
index 0000000..8b0d558
--- /dev/null
+++ b/c/olmoe_expert_runtime.c
@@ -0,0 +1,762 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Shared native OLMoE expert loading and execution runtime.  Routing,
+ * tokenization, sampling, and model tensor bytes are intentionally untouched.
+ */
+#define _GNU_SOURCE
+#include "olmoe_expert_runtime.h"
+
+#include <errno.h>
+#include <limits.h>
+#include <math.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "st.h"
+
+typedef struct {
+    int layer_id;
+    int expert_id;
+    int hidden_start;
+    int hidden_end;
+    int whole;
+} ownership_grant;
+
+typedef struct {
+    int valid;
+    int layer_id;
+    int expert_id;
+    uint64_t used;
+    int8_t *merged_weight;
+    float *row_scales;
+} expert_cache_entry;
+
+struct olmoe_expert_runtime {
+    shards tensors;
+    int hidden_dim;
+    int intermediate_dim;
+    int n_layers;
+    int n_experts;
+    int allow_all;
+    ownership_grant *grants;
+    int n_grants;
+    int grants_cap;
+    expert_cache_entry *cache;
+    int cache_cap;
+    uint64_t cache_clock;
+    size_t expert_bytes;
+    size_t memory_budget_bytes;
+    char model_path[2048];
+    char last_error[512];
+};
+
+static int runtime_error(olmoe_expert_runtime *r, const char *fmt, ...) {
+    if (r) {
+        va_list ap;
+        va_start(ap, fmt);
+        vsnprintf(r->last_error, sizeof(r->last_error), fmt, ap);
+        va_end(ap);
+    }
+    return -1;
+}
+
+const char *olmoe_expert_runtime_last_error(const olmoe_expert_runtime *r) {
+    return r ? r->last_error : "olmoe expert runtime is null";
+}
+
+static char *read_text_file(const char *path, size_t limit, size_t *size_out) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
+    long n = ftell(f);
+    if (n < 0 || (size_t)n > limit || fseek(f, 0, SEEK_SET) != 0) {
+        fclose(f); return NULL;
+    }
+    char *buf = (char *)malloc((size_t)n + 1);
+    if (!buf) { fclose(f); return NULL; }
+    if (fread(buf, 1, (size_t)n, f) != (size_t)n) {
+        free(buf); fclose(f); return NULL;
+    }
+    fclose(f);
+    buf[n] = 0;
+    if (size_out) *size_out = (size_t)n;
+    return buf;
+}
+
+static int json_int(jval *root, const char *name, int *out) {
+    jval *v = json_get(root, name);
+    if (!v || v->t != J_NUM || v->num < 0 || v->num > INT_MAX) return -1;
+    int n = (int)v->num;
+    if ((double)n != v->num) return -1;
+    *out = n;
+    return 0;
+}
+
+static int load_dimensions(olmoe_expert_runtime *r, const char *model_path) {
+    char path[2304];
+    snprintf(path, sizeof(path), "%s/config.json", model_path);
+    char *buf = read_text_file(path, 256u << 20, NULL);
+    if (!buf) {
+        snprintf(path, sizeof(path), "%s/manifest.json", model_path);
+        buf = read_text_file(path, 64u << 20, NULL);
+    }
+    if (!buf) return runtime_error(r, "cannot read config.json or manifest.json from %s", model_path);
+    char *arena = NULL;
+    jval *root = json_parse(buf, &arena);
+    int ok = root && root->t == J_OBJ
+          && json_int(root, "hidden_size", &r->hidden_dim) == 0
+          && json_int(root, "intermediate_size", &r->intermediate_dim) == 0
+          && json_int(root, "num_hidden_layers", &r->n_layers) == 0
+          && json_int(root, "num_experts", &r->n_experts) == 0;
+    free(buf); free(arena);
+    if (!ok || r->hidden_dim < 1 || r->intermediate_dim < 1 ||
+        r->n_layers < 1 || r->n_experts < 1) {
+        return runtime_error(r, "%s does not contain valid OLMoE dimensions", path);
+    }
+    return 0;
+}
+
+static int append_grant(olmoe_expert_runtime *r, ownership_grant grant) {
+    if (r->n_grants == r->grants_cap) {
+        int cap = r->grants_cap ? r->grants_cap * 2 : 32;
+        ownership_grant *p = (ownership_grant *)realloc(r->grants, (size_t)cap * sizeof(*p));
+        if (!p) return runtime_error(r, "out of memory reading ownership manifest");
+        r->grants = p; r->grants_cap = cap;
+    }
+    r->grants[r->n_grants++] = grant;
+    return 0;
+}
+
+static int parse_ownership_array(olmoe_expert_runtime *r, jval *array, int whole) {
+    if (!array) return 0;
+    if (array->t != J_ARR) return runtime_error(r, "ownership list must be a JSON array");
+    for (int i = 0; i < array->len; i++) {
+        jval *item = array->kids[i];
+        ownership_grant g;
+        memset(&g, 0, sizeof(g));
+        if (!item || item->t != J_OBJ ||
+            json_int(item, "layer_id", &g.layer_id) != 0 ||
+            json_int(item, "expert_id", &g.expert_id) != 0) {
+            return runtime_error(r, "ownership entry %d is missing integer layer_id/expert_id", i);
+        }
+        g.whole = whole;
+        if (whole) {
+            g.hidden_start = 0;
+            g.hidden_end = r->intermediate_dim;
+        } else if (json_int(item, "hidden_start", &g.hidden_start) != 0 ||
+                   json_int(item, "hidden_end", &g.hidden_end) != 0) {
+            return runtime_error(r, "microshard ownership entry %d is missing hidden_start/hidden_end", i);
+        }
+        if (g.layer_id < 0 || g.layer_id >= r->n_layers ||
+            g.expert_id < 0 || g.expert_id >= r->n_experts ||
+            g.hidden_start < 0 || g.hidden_end <= g.hidden_start ||
+            g.hidden_end > r->intermediate_dim) {
+            return runtime_error(r, "ownership entry %d is outside model dimensions", i);
+        }
+        if (append_grant(r, g) != 0) return -1;
+    }
+    return 0;
+}
+
+static int load_ownership(olmoe_expert_runtime *r, const char *manifest_path) {
+    if (!manifest_path || !*manifest_path) {
+        r->allow_all = 1; /* local engine only; workers always pass a manifest */
+        return 0;
+    }
+    char *buf = read_text_file(manifest_path, 64u << 20, NULL);
+    if (!buf) return runtime_error(r, "cannot read ownership manifest %s", manifest_path);
+    char *arena = NULL;
+    jval *root = json_parse(buf, &arena);
+    if (!root || root->t != J_OBJ ||
+        parse_ownership_array(r, json_get(root, "owned_experts"), 1) != 0 ||
+        parse_ownership_array(r, json_get(root, "owned_microshards"), 0) != 0) {
+        free(buf); free(arena);
+        if (!r->last_error[0]) runtime_error(r, "invalid ownership manifest %s", manifest_path);
+        return -1;
+    }
+    free(buf); free(arena);
+    if (r->n_grants == 0) return runtime_error(r, "ownership manifest %s grants no experts or slices", manifest_path);
+    return 0;
+}
+
+int olmoe_expert_runtime_owns(const olmoe_expert_runtime *r, int layer_id,
+                              int expert_id, int hidden_start, int hidden_end) {
+    if (!r || layer_id < 0 || layer_id >= r->n_layers ||
+        expert_id < 0 || expert_id >= r->n_experts || hidden_start < 0 ||
+        hidden_end <= hidden_start || hidden_end > r->intermediate_dim) return 0;
+    if (r->allow_all) return 1;
+    for (int i = 0; i < r->n_grants; i++) {
+        const ownership_grant *g = &r->grants[i];
+        if (g->layer_id == layer_id && g->expert_id == expert_id &&
+            g->hidden_start <= hidden_start && g->hidden_end >= hidden_end) return 1;
+    }
+    return 0;
+}
+
+static int tensor_names(int layer_id, int expert_id, char *weight, size_t weight_n,
+                        char *scales, size_t scales_n) {
+    int a = snprintf(weight, weight_n,
+        "model.layers.%d.mlp.experts.%d.merged_weight", layer_id, expert_id);
+    int b = snprintf(scales, scales_n,
+        "model.layers.%d.mlp.experts.%d.qs", layer_id, expert_id);
+    return a > 0 && b > 0 && (size_t)a < weight_n && (size_t)b < scales_n ? 0 : -1;
+}
+
+static int validate_full_tensors(olmoe_expert_runtime *r, int layer_id, int expert_id,
+                                 st_tensor **weight_out, st_tensor **scales_out) {
+    char weight[256], scales[256];
+    if (tensor_names(layer_id, expert_id, weight, sizeof(weight), scales, sizeof(scales)) != 0)
+        return runtime_error(r, "expert tensor name overflow");
+    st_tensor *tw = st_find(&r->tensors, weight);
+    st_tensor *ts = st_find(&r->tensors, scales);
+    int64_t ng = (int64_t)r->intermediate_dim * r->hidden_dim;
+    int64_t expected_weight = 2 * ng + (int64_t)r->hidden_dim * r->intermediate_dim;
+    int64_t expected_scales = 2ll * r->intermediate_dim + r->hidden_dim;
+    if (!tw || tw->dtype != 3 || tw->nbytes != expected_weight)
+        return runtime_error(r, "%s is absent or not the exact merged-int8 expert tensor", weight);
+    if (!ts || ts->dtype != 2 || ts->numel != expected_scales ||
+        ts->nbytes != expected_scales * (int64_t)sizeof(float))
+        return runtime_error(r, "%s is absent or not the exact F32 row-scale tensor", scales);
+    *weight_out = tw; *scales_out = ts;
+    return 0;
+}
+
+int olmoe_expert_runtime_load_into(olmoe_expert_runtime *r, int layer_id,
+                                   int expert_id, int8_t *merged_weight,
+                                   float *row_scales, int drop_after_read,
+                                   uint64_t *bytes_read) {
+    if (!r || !merged_weight || !row_scales) return runtime_error(r, "load_into received a null argument");
+    if (!olmoe_expert_runtime_owns(r, layer_id, expert_id, 0, r->intermediate_dim))
+        return runtime_error(r, "forbidden unowned whole expert layer=%d expert=%d", layer_id, expert_id);
+    st_tensor *tw, *ts;
+    if (validate_full_tensors(r, layer_id, expert_id, &tw, &ts) != 0) return -1;
+    st_pread_full(tw->fd, merged_weight, tw->nbytes, tw->off, "pread OLMoE merged expert");
+    st_pread_full(ts->fd, row_scales, ts->nbytes, ts->off, "pread OLMoE expert scales");
+    if (drop_after_read) {
+        posix_fadvise(tw->fd, tw->off, tw->nbytes, POSIX_FADV_DONTNEED);
+        posix_fadvise(ts->fd, ts->off, ts->nbytes, POSIX_FADV_DONTNEED);
+    }
+    if (bytes_read) *bytes_read = (uint64_t)tw->nbytes + (uint64_t)ts->nbytes;
+    return 0;
+}
+
+int olmoe_expert_runtime_dimensions(const olmoe_expert_runtime *r, int *hidden_dim,
+                                    int *intermediate_dim, int *n_layers,
+                                    int *n_experts) {
+    if (!r) return -1;
+    if (hidden_dim) *hidden_dim = r->hidden_dim;
+    if (intermediate_dim) *intermediate_dim = r->intermediate_dim;
+    if (n_layers) *n_layers = r->n_layers;
+    if (n_experts) *n_experts = r->n_experts;
+    return 0;
+}
+
+int olmoe_expert_runtime_open(const char *model_path, const char *ownership_manifest,
+                              size_t memory_budget_bytes,
+                              olmoe_expert_runtime **out) {
+    if (!model_path || !*model_path || !out) return -1;
+    *out = NULL;
+    olmoe_expert_runtime *r = (olmoe_expert_runtime *)calloc(1, sizeof(*r));
+    if (!r) return -1;
+    snprintf(r->model_path, sizeof(r->model_path), "%s", model_path);
+    if (load_dimensions(r, model_path) != 0 || load_ownership(r, ownership_manifest) != 0) {
+        fprintf(stderr, "olmoe_expert_runtime_open: %s\n", r->last_error);
+        olmoe_expert_runtime_close(r); return -1;
+    }
+    st_init(&r->tensors, model_path);
+    uint64_t weight = 3ull * (uint64_t)r->hidden_dim * (uint64_t)r->intermediate_dim;
+    uint64_t scales = 4ull * (2ull * (uint64_t)r->intermediate_dim + (uint64_t)r->hidden_dim);
+    if (weight > SIZE_MAX - scales) {
+        runtime_error(r, "expert byte count overflows size_t");
+        olmoe_expert_runtime_close(r); return -1;
+    }
+    r->expert_bytes = (size_t)(weight + scales);
+    r->memory_budget_bytes = memory_budget_bytes;
+    size_t capacity = memory_budget_bytes ? memory_budget_bytes / r->expert_bytes : 1;
+    if (memory_budget_bytes && capacity == 0) {
+        runtime_error(r, "memory budget %llu cannot hold one %llu-byte native expert",
+            (unsigned long long)memory_budget_bytes, (unsigned long long)r->expert_bytes);
+        fprintf(stderr, "olmoe_expert_runtime_open: %s\n", r->last_error);
+        olmoe_expert_runtime_close(r); return -1;
+    }
+    if (capacity > 4096) capacity = 4096;
+    r->cache_cap = (int)capacity;
+    r->cache = (expert_cache_entry *)calloc(capacity, sizeof(*r->cache));
+    if (!r->cache) {
+        runtime_error(r, "cannot allocate expert cache metadata");
+        olmoe_expert_runtime_close(r); return -1;
+    }
+    *out = r;
+    return 0;
+}
+
+void olmoe_expert_runtime_close(olmoe_expert_runtime *r) {
+    if (!r) return;
+    if (r->cache) for (int i = 0; i < r->cache_cap; i++) {
+        free(r->cache[i].merged_weight);
+        free(r->cache[i].row_scales);
+    }
+    for (int i = 0; i < r->tensors.nfd; i++) {
+        if (r->tensors.fds[i] >= 0) close(r->tensors.fds[i]);
+        if (r->tensors.dfds[i] >= 0) close(r->tensors.dfds[i]);
+        free(r->tensors.paths[i]);
+    }
+    free(r->tensors.t); free(r->tensors.hidx);
+    free(r->cache); free(r->grants); free(r);
+}
+
+/* Native int8/F32-scale matmul moved verbatim from olmoe.c.  Keeping this as
+ * the sole implementation is the central contract of the shared runtime. */
+#if defined(__ARM_NEON)
+#include <arm_neon.h>
+static inline int32_t runtime_dot_i8_16(const int8_t *a, const int8_t *b) {
+    int32x4_t acc = vdupq_n_s32(0);
+    int8x16_t va = vld1q_s8(a), vb = vld1q_s8(b);
+#if defined(__ARM_FEATURE_DOTPROD)
+    acc = vdotq_s32(acc, va, vb);
+#else
+    acc = vpadalq_s16(acc, vmull_s8(vget_low_s8(va),  vget_low_s8(vb)));
+    acc = vpadalq_s16(acc, vmull_s8(vget_high_s8(va), vget_high_s8(vb)));
+#endif
+    return vaddvq_s32(acc);
+}
+#define OLMOE_RUNTIME_FAST_DOT_I8 1
+#elif defined(__AVX2__)
+#include <immintrin.h>
+static inline int32_t runtime_dot_i8_16(const int8_t *a, const int8_t *b) {
+    __m256i va16 = _mm256_cvtepi8_epi16(_mm_loadu_si128((const __m128i*)a));
+    __m256i vb16 = _mm256_cvtepi8_epi16(_mm_loadu_si128((const __m128i*)b));
+    __m256i prod = _mm256_madd_epi16(va16, vb16);
+    __m128i sum128 = _mm_add_epi32(_mm256_castsi256_si128(prod), _mm256_extracti128_si256(prod, 1));
+    __m128i hi64 = _mm_unpackhi_epi64(sum128, sum128);
+    __m128i sum64 = _mm_add_epi32(sum128, hi64);
+    __m128i hi32 = _mm_shuffle_epi32(sum64, _MM_SHUFFLE(2, 3, 0, 1));
+    __m128i sum32 = _mm_add_epi32(sum64, hi32);
+    return _mm_cvtsi128_si32(sum32);
+}
+#define OLMOE_RUNTIME_FAST_DOT_I8 1
+#endif
+
+static void runtime_matmul_q(float *y, const float *x, const int8_t *q,
+                             const float *scale, int input_dim, int output_dim) {
+#if defined(OLMOE_RUNTIME_FAST_DOT_I8)
+    static int idot = -1;
+    if (idot < 0) { const char *e = getenv("IDOT"); idot = !(e && *e == '0'); }
+    if (idot && input_dim % 16 == 0 && input_dim <= 4096) {
+        int nb = input_dim / 16; int8_t xi[4096]; float xs[256];
+        for (int b = 0; b < nb; b++) {
+            const float *xb = x + b * 16;
+            float am = 0.f;
+            for (int i = 0; i < 16; i++) { float a = fabsf(xb[i]); if (a > am) am = a; }
+            float s = am / 127.f; if (s < 1e-12f) s = 1e-12f;
+            xs[b] = s; float inv = 1.f / s;
+            for (int i = 0; i < 16; i++) xi[b * 16 + i] = (int8_t)lrintf(xb[i] * inv);
+        }
+        #pragma omp parallel for schedule(static)
+        for (int o = 0; o < output_dim; o++) {
+            const int8_t *w = q + (int64_t)o * input_dim;
+            float acc = 0.f;
+            for (int b = 0; b < nb; b++)
+                acc += xs[b] * (float)runtime_dot_i8_16(xi + b * 16, w + b * 16);
+            y[o] = acc * scale[o];
+        }
+        return;
+    }
+#endif
+    #pragma omp parallel for schedule(static)
+    for (int o = 0; o < output_dim; o++) {
+        const int8_t *w = q + (int64_t)o * input_dim;
+        float acc = 0.f;
+        #pragma omp simd reduction(+:acc)
+        for (int i = 0; i < input_dim; i++) acc += x[i] * (float)w[i];
+        y[o] = acc * scale[o];
+    }
+}
+
+int olmoe_expert_runtime_execute_view_with_workspace(
+                                  const olmoe_native_expert_view *expert,
+                                  const float *activation, float routing_weight,
+                                  float *output, float *gate, float *up) {
+    if (!expert || !activation || !output || !gate || !up ||
+        expert->hidden_dim < 1 || expert->intermediate_dim < 1 ||
+        expert->intermediate_width < 1 || expert->intermediate_start < 0 ||
+        expert->intermediate_start + expert->intermediate_width > expert->intermediate_dim ||
+        !expert->gate_q || !expert->up_q || !expert->down_q ||
+        !expert->gate_scale || !expert->up_scale || !expert->down_scale) return -1;
+    int width = expert->intermediate_width;
+    runtime_matmul_q(gate, activation, expert->gate_q, expert->gate_scale,
+                     expert->hidden_dim, width);
+    runtime_matmul_q(up, activation, expert->up_q, expert->up_scale,
+                     expert->hidden_dim, width);
+    for (int i = 0; i < width; i++) {
+        float g = gate[i];
+        gate[i] = (g / (1.f + expf(-g))) * up[i];
+    }
+    runtime_matmul_q(output, gate, expert->down_q, expert->down_scale,
+                     width, expert->hidden_dim);
+    for (int d = 0; d < expert->hidden_dim; d++) output[d] *= routing_weight;
+    return 0;
+}
+
+int olmoe_expert_runtime_accumulate_view_with_workspace(
+        const olmoe_native_expert_view *expert, const float *activation,
+        float routing_weight, float *accumulator, float *gate, float *up,
+        float *down) {
+    if (!accumulator || !down) return -1;
+    if (olmoe_expert_runtime_execute_view_with_workspace(
+            expert, activation, 1.f, down, gate, up) != 0) return -1;
+    return olmoe_expert_runtime_accumulate_exact_output(
+        expert->hidden_dim, routing_weight, down, accumulator);
+}
+
+int olmoe_expert_runtime_accumulate_exact_output(int hidden_dim,
+        float routing_weight, const float *unweighted_expert_output,
+        float *accumulator) {
+    if (hidden_dim < 1 || !unweighted_expert_output || !accumulator) return -1;
+    for (int d = 0; d < hidden_dim; d++)
+        accumulator[d] += routing_weight * unweighted_expert_output[d];
+    return 0;
+}
+
+int olmoe_expert_runtime_execute_view(const olmoe_native_expert_view *expert,
+                                      const float *activation,
+                                      float routing_weight, float *output) {
+    if (!expert || expert->intermediate_width < 1) return -1;
+    float *workspace = (float *)malloc((size_t)expert->intermediate_width * 2 * sizeof(float));
+    if (!workspace) return -1;
+    int rc = olmoe_expert_runtime_execute_view_with_workspace(
+        expert, activation, routing_weight, output,
+        workspace, workspace + expert->intermediate_width);
+    free(workspace);
+    return rc;
+}
+
+static expert_cache_entry *cache_get(olmoe_expert_runtime *r, int layer_id, int expert_id) {
+    for (int i = 0; i < r->cache_cap; i++) {
+        expert_cache_entry *e = &r->cache[i];
+        if (e->valid && e->layer_id == layer_id && e->expert_id == expert_id) {
+            e->used = ++r->cache_clock; return e;
+        }
+    }
+    int victim = -1;
+    for (int i = 0; i < r->cache_cap; i++) {
+        if (!r->cache[i].valid) { victim = i; break; }
+        if (victim < 0 || r->cache[i].used < r->cache[victim].used) victim = i;
+    }
+    if (victim < 0) { runtime_error(r, "native expert cache has no usable slot"); return NULL; }
+    expert_cache_entry *e = &r->cache[victim];
+    int64_t matrix_elems = 3ll * r->hidden_dim * r->intermediate_dim;
+    int64_t scale_elems = 2ll * r->intermediate_dim + r->hidden_dim;
+    if (!e->merged_weight) e->merged_weight = (int8_t *)malloc((size_t)matrix_elems);
+    if (!e->row_scales) e->row_scales = (float *)malloc((size_t)scale_elems * sizeof(float));
+    if (!e->merged_weight || !e->row_scales) {
+        runtime_error(r, "out of memory loading native expert"); return NULL;
+    }
+    if (olmoe_expert_runtime_load_into(r, layer_id, expert_id, e->merged_weight,
+                                       e->row_scales, 0, NULL) != 0) return NULL;
+    e->valid = 1; e->layer_id = layer_id; e->expert_id = expert_id;
+    e->used = ++r->cache_clock;
+    return e;
+}
+
+static void cache_entry_view(const olmoe_expert_runtime *r, const expert_cache_entry *entry,
+                             olmoe_native_expert_view *view) {
+    int64_t ng = (int64_t)r->intermediate_dim * r->hidden_dim;
+    memset(view, 0, sizeof(*view));
+    view->layer_id = entry->layer_id; view->expert_id = entry->expert_id;
+    view->hidden_dim = r->hidden_dim; view->intermediate_dim = r->intermediate_dim;
+    view->intermediate_start = 0; view->intermediate_width = r->intermediate_dim;
+    view->gate_q = entry->merged_weight;
+    view->up_q = entry->merged_weight + ng;
+    view->down_q = entry->merged_weight + 2 * ng;
+    view->gate_scale = entry->row_scales;
+    view->up_scale = entry->row_scales + r->intermediate_dim;
+    view->down_scale = entry->row_scales + 2 * r->intermediate_dim;
+}
+
+static int validate_request(olmoe_expert_runtime *r, const olmoe_expert_request *request) {
+    if (!r || !request || !request->expert_ids || !request->routing_weights ||
+        !request->activations || request->layer_id < 0 || request->layer_id >= r->n_layers ||
+        request->batch_rows < 1 || request->batch_rows > (1 << 20) ||
+        request->hidden_dim != r->hidden_dim || request->top_k < 1 ||
+        request->top_k > r->n_experts)
+        return runtime_error(r, "invalid native expert request dimensions or pointers");
+    return 0;
+}
+
+int olmoe_expert_runtime_execute_exact_contributions(olmoe_expert_runtime *r,
+        const olmoe_expert_request *request, float *per_expert_outputs) {
+    if (validate_request(r, request) != 0 || !per_expert_outputs)
+        return runtime_error(r, "invalid exact-contribution output buffer");
+    int D = r->hidden_dim, I = r->intermediate_dim;
+    float *workspace = (float *)malloc(((size_t)I * 2 + D) * sizeof(float));
+    if (!workspace) return runtime_error(r, "out of memory preserving exact contribution order");
+    float *gate = workspace, *up = workspace + I, *down = workspace + 2 * I;
+    for (int row = 0; row < request->batch_rows; row++) {
+        const float *activation = request->activations + (int64_t)row * D;
+        for (int rank = 0; rank < request->top_k; rank++) {
+            int at = row * request->top_k + rank;
+            int expert_id = request->expert_ids[at];
+            if (!olmoe_expert_runtime_owns(r, request->layer_id, expert_id, 0, r->intermediate_dim))
+                return runtime_error(r, "request asks for unowned whole expert layer=%d expert=%d",
+                                     request->layer_id, expert_id);
+            expert_cache_entry *entry = cache_get(r, request->layer_id, expert_id);
+            if (!entry) { free(workspace); return -1; }
+            olmoe_native_expert_view view;
+            cache_entry_view(r, entry, &view);
+            float *out = per_expert_outputs + ((int64_t)row * request->top_k + rank) * D;
+            memset(out, 0, (size_t)D * sizeof(float));
+            if (olmoe_expert_runtime_accumulate_view_with_workspace(
+                    &view, activation, request->routing_weights[at], out,
+                    gate, up, down) != 0) {
+                free(workspace);
+                return runtime_error(r, "native whole-expert execution failed");
+            }
+        }
+    }
+    free(workspace); return 0;
+}
+
+int olmoe_expert_runtime_execute_whole(olmoe_expert_runtime *r,
+        const olmoe_expert_request *request, float *output) {
+    if (validate_request(r, request) != 0 || !output)
+        return runtime_error(r, "invalid whole-expert output buffer");
+    int D = r->hidden_dim;
+    memset(output, 0, (size_t)request->batch_rows * D * sizeof(float));
+    float *one = (float *)malloc((size_t)D * sizeof(float));
+    if (!one) return runtime_error(r, "out of memory aggregating whole-expert output");
+    for (int row = 0; row < request->batch_rows; row++) {
+        const float *activation = request->activations + (int64_t)row * D;
+        float *row_out = output + (int64_t)row * D;
+        for (int rank = 0; rank < request->top_k; rank++) {
+            int at = row * request->top_k + rank;
+            int expert_id = request->expert_ids[at];
+            expert_cache_entry *entry = cache_get(r, request->layer_id, expert_id);
+            if (!entry) { free(one); return -1; }
+            olmoe_native_expert_view view; cache_entry_view(r, entry, &view);
+            if (olmoe_expert_runtime_execute_view(&view, activation,
+                    request->routing_weights[at], one) != 0) {
+                free(one); return runtime_error(r, "native whole-expert execution failed");
+            }
+            /* Rank-preserving accumulation: same order as local Colibri. */
+            for (int d = 0; d < D; d++) row_out[d] += one[d];
+        }
+    }
+    free(one); return 0;
+}
+
+static int load_native_slice(olmoe_expert_runtime *r, const olmoe_expert_slice *slice,
+                             olmoe_native_expert_view *view, int8_t **weight_owner,
+                             float **scale_owner) {
+    int start = slice->hidden_start, end = slice->hidden_end, width = end - start;
+    if (!olmoe_expert_runtime_owns(r, slice->layer_id, slice->expert_id, start, end))
+        return runtime_error(r, "forbidden unowned microshard layer=%d expert=%d range=%d:%d",
+                             slice->layer_id, slice->expert_id, start, end);
+    uint64_t weight_bytes = 3ull * (uint64_t)r->hidden_dim * (uint64_t)width;
+    uint64_t scale_bytes = 4ull * (2ull * (uint64_t)width + (uint64_t)r->hidden_dim);
+    if (weight_bytes > SIZE_MAX - scale_bytes ||
+        (r->memory_budget_bytes && weight_bytes + scale_bytes > r->memory_budget_bytes))
+        return runtime_error(r, "native microshard exceeds worker memory budget");
+    int8_t *weights = (int8_t *)malloc((size_t)weight_bytes);
+    float *scales = (float *)malloc((size_t)scale_bytes);
+    if (!weights || !scales) {
+        free(weights); free(scales); return runtime_error(r, "out of memory loading native microshard");
+    }
+
+    /* Worker banks store a slice as three packed native matrices under a
+     * range-qualified name.  During conversion tests the exact source model
+     * may also be used; in that case read only the authorised rows/columns
+     * directly from the full tensor and never materialise the unowned bytes. */
+    char slice_weight[320], slice_scales[320];
+    snprintf(slice_weight, sizeof(slice_weight),
+        "model.layers.%d.mlp.experts.%d.microshards.%d_%d.merged_weight",
+        slice->layer_id, slice->expert_id, start, end);
+    snprintf(slice_scales, sizeof(slice_scales),
+        "model.layers.%d.mlp.experts.%d.microshards.%d_%d.qs",
+        slice->layer_id, slice->expert_id, start, end);
+    st_tensor *sw = st_find(&r->tensors, slice_weight);
+    st_tensor *ss = st_find(&r->tensors, slice_scales);
+    if (sw || ss) {
+        int64_t expected_scales = 2ll * width + r->hidden_dim;
+        if (!sw || !ss || sw->dtype != 3 || sw->nbytes != (int64_t)weight_bytes ||
+            ss->dtype != 2 || ss->numel != expected_scales ||
+            ss->nbytes != (int64_t)scale_bytes) {
+            free(weights); free(scales);
+            return runtime_error(r, "range-qualified native microshard tensors have invalid shape/dtype");
+        }
+        st_pread_full(sw->fd, weights, sw->nbytes, sw->off, "pread OLMoE microshard weights");
+        st_pread_full(ss->fd, scales, ss->nbytes, ss->off, "pread OLMoE microshard scales");
+    } else {
+        st_tensor *tw, *ts;
+        if (validate_full_tensors(r, slice->layer_id, slice->expert_id, &tw, &ts) != 0) {
+            free(weights); free(scales); return -1;
+        }
+        int64_t D = r->hidden_dim, I = r->intermediate_dim;
+        int64_t gate_bytes = (int64_t)width * D;
+        int8_t *gate = weights, *up = weights + gate_bytes, *down = weights + 2 * gate_bytes;
+        st_pread_full(tw->fd, gate, gate_bytes, tw->off + (int64_t)start * D,
+                      "pread OLMoE microshard gate rows");
+        st_pread_full(tw->fd, up, gate_bytes,
+                      tw->off + I * D + (int64_t)start * D,
+                      "pread OLMoE microshard up rows");
+        for (int d = 0; d < r->hidden_dim; d++)
+            st_pread_full(tw->fd, down + (int64_t)d * width, width,
+                          tw->off + 2 * I * D + (int64_t)d * I + start,
+                          "pread OLMoE microshard down columns");
+        st_pread_full(ts->fd, scales, (int64_t)width * sizeof(float),
+                      ts->off + (int64_t)start * sizeof(float),
+                      "pread OLMoE microshard gate scales");
+        st_pread_full(ts->fd, scales + width, (int64_t)width * sizeof(float),
+                      ts->off + (int64_t)(I + start) * sizeof(float),
+                      "pread OLMoE microshard up scales");
+        st_pread_full(ts->fd, scales + 2 * width, (int64_t)D * sizeof(float),
+                      ts->off + 2 * I * (int64_t)sizeof(float),
+                      "pread OLMoE microshard down scales");
+    }
+    memset(view, 0, sizeof(*view));
+    view->layer_id = slice->layer_id; view->expert_id = slice->expert_id;
+    view->hidden_dim = r->hidden_dim; view->intermediate_dim = r->intermediate_dim;
+    view->intermediate_start = start; view->intermediate_width = width;
+    view->gate_q = weights;
+    view->up_q = weights + (int64_t)width * r->hidden_dim;
+    view->down_q = weights + 2ll * width * r->hidden_dim;
+    view->gate_scale = scales;
+    view->up_scale = scales + width;
+    view->down_scale = scales + 2 * width;
+    *weight_owner = weights; *scale_owner = scales;
+    return 0;
+}
+
+int olmoe_expert_runtime_execute_microshards(olmoe_expert_runtime *r,
+        const olmoe_expert_request *request, const olmoe_expert_slice *slices,
+        int n_slices, float *partial_output) {
+    if (validate_request(r, request) != 0 || !slices || n_slices < 1 || !partial_output)
+        return runtime_error(r, "invalid native microshard request");
+    int D = r->hidden_dim;
+    memset(partial_output, 0, (size_t)request->batch_rows * D * sizeof(float));
+    float *one = (float *)malloc((size_t)D * sizeof(float));
+    if (!one) return runtime_error(r, "out of memory reducing microshards");
+    for (int si = 0; si < n_slices; si++) {
+        if (slices[si].layer_id != request->layer_id) {
+            free(one); return runtime_error(r, "microshard layer differs from request layer");
+        }
+        olmoe_native_expert_view view; int8_t *weights = NULL; float *scales = NULL;
+        if (load_native_slice(r, &slices[si], &view, &weights, &scales) != 0) {
+            free(one); return -1;
+        }
+        for (int row = 0; row < request->batch_rows; row++) {
+            const float *activation = request->activations + (int64_t)row * D;
+            float *row_out = partial_output + (int64_t)row * D;
+            for (int rank = 0; rank < request->top_k; rank++) {
+                int at = row * request->top_k + rank;
+                if (request->expert_ids[at] != slices[si].expert_id) continue;
+                if (olmoe_expert_runtime_execute_view(&view, activation,
+                        request->routing_weights[at], one) != 0) {
+                    free(weights); free(scales); free(one);
+                    return runtime_error(r, "native microshard execution failed");
+                }
+                for (int d = 0; d < D; d++) row_out[d] += one[d];
+            }
+        }
+        free(weights); free(scales);
+    }
+    free(one); return 0;
+}
+
+/* Small self-contained SHA-256 implementation for native expert-content
+ * fingerprints.  Hashing is over the exact stored merged-weight bytes followed
+ * by the exact stored scale bytes; no dequantisation or re-encoding occurs. */
+typedef struct {
+    uint32_t h[8];
+    uint64_t bits;
+    uint8_t block[64];
+    size_t used;
+} runtime_sha256;
+
+static uint32_t rr32(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+static void sha256_block(runtime_sha256 *s, const uint8_t block[64]) {
+    static const uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
+    };
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++)
+        w[i] = ((uint32_t)block[i*4] << 24) | ((uint32_t)block[i*4+1] << 16) |
+               ((uint32_t)block[i*4+2] << 8) | block[i*4+3];
+    for (int i = 16; i < 64; i++) {
+        uint32_t a = rr32(w[i-15],7) ^ rr32(w[i-15],18) ^ (w[i-15] >> 3);
+        uint32_t b = rr32(w[i-2],17) ^ rr32(w[i-2],19) ^ (w[i-2] >> 10);
+        w[i] = w[i-16] + a + w[i-7] + b;
+    }
+    uint32_t a=s->h[0],b=s->h[1],c=s->h[2],d=s->h[3],e=s->h[4],f=s->h[5],g=s->h[6],h=s->h[7];
+    for (int i = 0; i < 64; i++) {
+        uint32_t s1=rr32(e,6)^rr32(e,11)^rr32(e,25), ch=(e&f)^((~e)&g);
+        uint32_t t1=h+s1+ch+k[i]+w[i], s0=rr32(a,2)^rr32(a,13)^rr32(a,22);
+        uint32_t maj=(a&b)^(a&c)^(b&c), t2=s0+maj;
+        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    s->h[0]+=a;s->h[1]+=b;s->h[2]+=c;s->h[3]+=d;
+    s->h[4]+=e;s->h[5]+=f;s->h[6]+=g;s->h[7]+=h;
+}
+
+static void sha256_init(runtime_sha256 *s) {
+    static const uint32_t init[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+        0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    memcpy(s->h,init,sizeof(init)); s->bits=0; s->used=0;
+}
+static void sha256_update(runtime_sha256 *s, const void *data_, size_t n) {
+    const uint8_t *data=(const uint8_t *)data_; s->bits += (uint64_t)n * 8;
+    while (n) {
+        size_t take=64-s->used; if(take>n)take=n;
+        memcpy(s->block+s->used,data,take);s->used+=take;data+=take;n-=take;
+        if(s->used==64){sha256_block(s,s->block);s->used=0;}
+    }
+}
+static void sha256_final(runtime_sha256 *s, uint8_t out[32]) {
+    s->block[s->used++]=0x80;
+    if(s->used>56){while(s->used<64)s->block[s->used++]=0;sha256_block(s,s->block);s->used=0;}
+    while(s->used<56)s->block[s->used++]=0;
+    for(int i=7;i>=0;i--)s->block[s->used++]=(uint8_t)(s->bits>>(i*8));
+    sha256_block(s,s->block);
+    for(int i=0;i<8;i++){out[i*4]=(uint8_t)(s->h[i]>>24);out[i*4+1]=(uint8_t)(s->h[i]>>16);
+        out[i*4+2]=(uint8_t)(s->h[i]>>8);out[i*4+3]=(uint8_t)s->h[i];}
+}
+
+static int sha256_tensor(runtime_sha256 *hash, st_tensor *tensor) {
+    uint8_t *buf = (uint8_t *)malloc(1u << 20);
+    if (!buf) return -1;
+    int64_t at = 0;
+    while (at < tensor->nbytes) {
+        int64_t n = tensor->nbytes - at; if (n > (1 << 20)) n = 1 << 20;
+        st_pread_full(tensor->fd, buf, n, tensor->off + at, "pread OLMoE content hash");
+        sha256_update(hash, buf, (size_t)n); at += n;
+    }
+    free(buf); return 0;
+}
+
+int olmoe_expert_runtime_content_hash(olmoe_expert_runtime *r, int layer_id,
+                                      int expert_id, char sha256_hex[65]) {
+    if (!r || !sha256_hex ||
+        !olmoe_expert_runtime_owns(r, layer_id, expert_id, 0, r->intermediate_dim))
+        return runtime_error(r, "cannot hash an unowned whole expert");
+    st_tensor *tw, *ts;
+    if (validate_full_tensors(r, layer_id, expert_id, &tw, &ts) != 0) return -1;
+    runtime_sha256 hash; uint8_t digest[32]; sha256_init(&hash);
+    if (sha256_tensor(&hash, tw) != 0 || sha256_tensor(&hash, ts) != 0)
+        return runtime_error(r, "out of memory hashing native expert");
+    sha256_final(&hash, digest);
+    static const char hex[]="0123456789abcdef";
+    for(int i=0;i<32;i++){sha256_hex[i*2]=hex[digest[i]>>4];sha256_hex[i*2+1]=hex[digest[i]&15];}
+    sha256_hex[64]=0; return 0;
+}
diff --git a/c/olmoe_expert_runtime.h b/c/olmoe_expert_runtime.h
new file mode 100644
index 0000000..605ae3f
--- /dev/null
+++ b/c/olmoe_expert_runtime.h
@@ -0,0 +1,164 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Shared native OLMoE expert loading and execution runtime.  This file does
+ * not alter routing, tokenization, sampling, or model tensor bytes.
+ */
+#ifndef OLMOE_EXPERT_RUNTIME_H
+#define OLMOE_EXPERT_RUNTIME_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct olmoe_expert_runtime olmoe_expert_runtime;
+
+typedef struct {
+    int layer_id;
+    int expert_id;
+    int hidden_start;
+    int hidden_end;
+} olmoe_expert_slice;
+
+/* expert_ids and routing_weights are row-major [batch_rows, top_k]. */
+typedef struct {
+    int layer_id;
+    int batch_rows;
+    int hidden_dim;
+    int top_k;
+    const int *expert_ids;
+    const float *routing_weights;
+    const float *activations;
+} olmoe_expert_request;
+
+/* A borrowed view over one native merged-int8 expert.  Gate and up are
+ * [intermediate_width, hidden_dim].  Down is
+ * [hidden_dim, intermediate_width].  The full local-engine view has
+ * intermediate_start=0 and intermediate_width=intermediate_dim; a native
+ * microshard view owns only its indicated range. */
+typedef struct {
+    int layer_id;
+    int expert_id;
+    int hidden_dim;
+    int intermediate_dim;
+    int intermediate_start;
+    int intermediate_width;
+    const int8_t *gate_q;
+    const int8_t *up_q;
+    const int8_t *down_q;
+    const float *gate_scale;
+    const float *up_scale;
+    const float *down_scale;
+} olmoe_native_expert_view;
+
+int olmoe_expert_runtime_open(
+    const char *model_path,
+    const char *ownership_manifest,
+    size_t memory_budget_bytes,
+    olmoe_expert_runtime **out
+);
+
+int olmoe_expert_runtime_execute_whole(
+    olmoe_expert_runtime *runtime,
+    const olmoe_expert_request *request,
+    float *output
+);
+
+int olmoe_expert_runtime_execute_exact_contributions(
+    olmoe_expert_runtime *runtime,
+    const olmoe_expert_request *request,
+    float *per_expert_outputs
+);
+
+int olmoe_expert_runtime_execute_microshards(
+    olmoe_expert_runtime *runtime,
+    const olmoe_expert_request *request,
+    const olmoe_expert_slice *slices,
+    int n_slices,
+    float *partial_output
+);
+
+void olmoe_expert_runtime_close(olmoe_expert_runtime *runtime);
+
+/* Shared local-engine/worker helpers.  They are part of the downstream ABI so
+ * the engine's existing LRU slots and the worker's bounded cache can both call
+ * the exact same loader and arithmetic without copying implementation code. */
+int olmoe_expert_runtime_dimensions(
+    const olmoe_expert_runtime *runtime,
+    int *hidden_dim,
+    int *intermediate_dim,
+    int *n_layers,
+    int *n_experts
+);
+
+int olmoe_expert_runtime_owns(
+    const olmoe_expert_runtime *runtime,
+    int layer_id,
+    int expert_id,
+    int hidden_start,
+    int hidden_end
+);
+
+int olmoe_expert_runtime_load_into(
+    olmoe_expert_runtime *runtime,
+    int layer_id,
+    int expert_id,
+    int8_t *merged_weight,
+    float *row_scales,
+    int drop_after_read,
+    uint64_t *bytes_read
+);
+
+int olmoe_expert_runtime_execute_view(
+    const olmoe_native_expert_view *expert,
+    const float *activation,
+    float routing_weight,
+    float *output
+);
+
+int olmoe_expert_runtime_execute_view_with_workspace(
+    const olmoe_native_expert_view *expert,
+    const float *activation,
+    float routing_weight,
+    float *output,
+    float *gate_workspace,
+    float *up_workspace
+);
+
+int olmoe_expert_runtime_accumulate_view_with_workspace(
+    const olmoe_native_expert_view *expert,
+    const float *activation,
+    float routing_weight,
+    float *accumulator,
+    float *gate_workspace,
+    float *up_workspace,
+    float *down_workspace
+);
+
+int olmoe_expert_runtime_accumulate_exact_output(
+    int hidden_dim,
+    float routing_weight,
+    const float *unweighted_expert_output,
+    float *accumulator
+);
+
+int olmoe_expert_runtime_content_hash(
+    olmoe_expert_runtime *runtime,
+    int layer_id,
+    int expert_id,
+    char sha256_hex[65]
+);
+
+const char *olmoe_expert_runtime_last_error(
+    const olmoe_expert_runtime *runtime
+);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/c/olmoe_expert_worker.c b/c/olmoe_expert_worker.c
new file mode 100644
index 0000000..50a7472
--- /dev/null
+++ b/c/olmoe_expert_worker.c
@@ -0,0 +1,98 @@
+/*
+ * Copyright 2025 Colibri contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Downstream modification for swarm-inference-lab Experiment 010.
+ * Native OLMoE worker host.  Patch 0005 establishes the shared-runtime
+ * executable and its fail-closed probe surface; the canonical SWARMEX1 data
+ * plane is added by the following downstream wire/dispatch patches.
+ */
+#include "olmoe_expert_runtime.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int read_activation(const char *path, float *activation, int hidden_dim) {
+    FILE *f = fopen(path, "rb");
+    if (!f) { perror(path); return -1; }
+    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return -1; }
+    long n = ftell(f);
+    if (n != (long)((size_t)hidden_dim * sizeof(float)) || fseek(f, 0, SEEK_SET) != 0) {
+        fprintf(stderr, "%s: activation must contain exactly %d native float32 values\n",
+                path, hidden_dim);
+        fclose(f); return -1;
+    }
+    int ok = fread(activation, sizeof(float), (size_t)hidden_dim, f) == (size_t)hidden_dim;
+    fclose(f); return ok ? 0 : -1;
+}
+
+static int write_output(const char *path, const float *output, int hidden_dim) {
+    FILE *f = fopen(path, "wb");
+    if (!f) { perror(path); return -1; }
+    int ok = fwrite(output, sizeof(float), (size_t)hidden_dim, f) == (size_t)hidden_dim;
+    if (fclose(f) != 0) ok = 0;
+    return ok ? 0 : -1;
+}
+
+static int parse_int(const char *text, int *out) {
+    char *end = NULL; errno = 0; long value = strtol(text, &end, 10);
+    if (errno || !end || *end || value < 0 || value > 0x7fffffffL) return -1;
+    *out = (int)value; return 0;
+}
+
+static int parse_budget(const char *text, size_t *out) {
+    char *end = NULL; errno = 0; unsigned long long value = strtoull(text, &end, 10);
+    if (errno || !end || *end || value > (size_t)-1) return -1;
+    *out = (size_t)value; return 0;
+}
+
+static void usage(const char *program) {
+    fprintf(stderr,
+        "usage:\n"
+        "  %s --hash MODEL OWNERSHIP LAYER EXPERT\n"
+        "  %s --execute-whole MODEL OWNERSHIP BUDGET_BYTES LAYER EXPERT ROUTING_WEIGHT ACTIVATION_F32 OUTPUT_F32\n",
+        program, program);
+}
+
+int main(int argc, char **argv) {
+    if (argc == 6 && strcmp(argv[1], "--hash") == 0) {
+        int layer, expert;
+        if (parse_int(argv[4], &layer) != 0 || parse_int(argv[5], &expert) != 0) {
+            usage(argv[0]); return 2;
+        }
+        olmoe_expert_runtime *runtime = NULL;
+        if (olmoe_expert_runtime_open(argv[2], argv[3], 0, &runtime) != 0) return 3;
+        char hash[65];
+        int rc = olmoe_expert_runtime_content_hash(runtime, layer, expert, hash);
+        if (rc == 0) printf("%s\n", hash);
+        else fprintf(stderr, "%s\n", olmoe_expert_runtime_last_error(runtime));
+        olmoe_expert_runtime_close(runtime); return rc == 0 ? 0 : 4;
+    }
+    if (argc == 10 && strcmp(argv[1], "--execute-whole") == 0) {
+        size_t budget; int layer, expert;
+        char *weight_end = NULL; errno = 0; float routing = strtof(argv[7], &weight_end);
+        if (parse_budget(argv[4], &budget) != 0 || parse_int(argv[5], &layer) != 0 ||
+            parse_int(argv[6], &expert) != 0 || errno || !weight_end || *weight_end) {
+            usage(argv[0]); return 2;
+        }
+        olmoe_expert_runtime *runtime = NULL;
+        if (olmoe_expert_runtime_open(argv[2], argv[3], budget, &runtime) != 0) return 3;
+        int hidden;
+        olmoe_expert_runtime_dimensions(runtime, &hidden, NULL, NULL, NULL);
+        float *activation = (float *)malloc((size_t)hidden * sizeof(float));
+        float *output = (float *)malloc((size_t)hidden * sizeof(float));
+        if (!activation || !output || read_activation(argv[8], activation, hidden) != 0) {
+            fprintf(stderr, "cannot read activation\n"); free(activation); free(output);
+            olmoe_expert_runtime_close(runtime); return 5;
+        }
+        olmoe_expert_request request = {layer, 1, hidden, 1, &expert, &routing, activation};
+        int rc = olmoe_expert_runtime_execute_whole(runtime, &request, output);
+        if (rc == 0) rc = write_output(argv[9], output, hidden);
+        if (rc != 0) fprintf(stderr, "%s\n", olmoe_expert_runtime_last_error(runtime));
+        free(activation); free(output); olmoe_expert_runtime_close(runtime);
+        return rc == 0 ? 0 : 6;
+    }
+    usage(argv[0]); return 2;
+}
diff --git a/c/tests/test_olmoe_expert_runtime.c b/c/tests/test_olmoe_expert_runtime.c
new file mode 100644
index 0000000..25abc1c
--- /dev/null
+++ b/c/tests/test_olmoe_expert_runtime.c
@@ -0,0 +1,44 @@
+/* Copyright 2025 Colibri contributors; SPDX-License-Identifier: Apache-2.0
+ * Downstream Experiment 010 shared-runtime equivalence test. */
+#include "../olmoe_expert_runtime.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static void reference_matmul(float *y, const float *x, const int8_t *q,
+                             const float *scale, int input, int output) {
+    for (int o = 0; o < output; o++) {
+        float acc = 0.f;
+        for (int i = 0; i < input; i++) acc += x[i] * (float)q[o * input + i];
+        y[o] = acc * scale[o];
+    }
+}
+
+int main(void) {
+    enum { D = 4, I = 3 };
+    const int8_t gate[I*D] = {1,-2,3,4, -3,1,2,-1, 2,2,-2,1};
+    const int8_t up[I*D] = {-1,2,1,3, 2,-2,3,1, 1,4,-1,-2};
+    const int8_t down[D*I] = {1,2,-1, -2,1,3, 2,-3,1, 4,1,-2};
+    const float gs[I] = {0.25f,0.125f,0.5f};
+    const float us[I] = {0.5f,0.25f,0.125f};
+    const float ds[D] = {0.25f,0.5f,0.125f,0.0625f};
+    const float x[D] = {0.75f,-1.25f,0.5f,2.f};
+    const float routing = 0.375f;
+    float g[I], u[I], reference[D], actual[D], accumulator[D] = {1.f,-2.f,3.f,-4.f};
+    reference_matmul(g,x,gate,gs,D,I); reference_matmul(u,x,up,us,D,I);
+    for(int i=0;i<I;i++){float v=g[i];g[i]=(v/(1.f+expf(-v)))*u[i];}
+    reference_matmul(reference,g,down,ds,I,D);
+    for(int d=0;d<D;d++) reference[d]*=routing;
+    olmoe_native_expert_view view={0,7,D,I,0,I,gate,up,down,gs,us,ds};
+    if(olmoe_expert_runtime_execute_view(&view,x,routing,actual)!=0)return 1;
+    for(int d=0;d<D;d++)if(memcmp(&reference[d],&actual[d],sizeof(float))!=0){
+        fprintf(stderr,"shared runtime mismatch at %d: %.9g != %.9g\n",d,actual[d],reference[d]);return 2;}
+    float before[D];memcpy(before,accumulator,sizeof(before));
+    float gw[I],uw[I],dw[D];
+    if(olmoe_expert_runtime_accumulate_view_with_workspace(&view,x,routing,accumulator,gw,uw,dw)!=0)return 3;
+    for(int d=0;d<D;d++)if(memcmp(&accumulator[d],&(float){before[d]+reference[d]},sizeof(float))!=0)return 4;
+    puts("shared OLMoE expert runtime matches the local scalar contract");
+    return 0;
