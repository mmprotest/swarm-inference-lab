artifacts/*
.runtime/
!artifacts/.gitkeep
!artifacts/runs/
!artifacts/models/
!artifacts/validation/
artifacts/runs/*
artifacts/models/*
artifacts/validation/*
!artifacts/runs/.gitkeep
!artifacts/models/.gitkeep
!artifacts/validation/.gitkeep

