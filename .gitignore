# Native release payloads are generated, hash-addressed build products.
release/generated/*
!release/generated/.gitkeep
release/fixtures/
installer/windows/payload/

# Local secrets and machine-specific configuration.
.env
.env.*
!.env.example

# Track lightweight experiment evidence and metadata. Keep local runtimes,
# model payloads, archives, and current files >= 50 MiB out of Git.
.runtime/
/artifacts/models/
/artifacts/backend-environments/
/artifacts/**/*.zip
/artifacts/**/*.tar
/artifacts/**/*.tar.gz

# Generated acceptance/CI workspaces are reproducible test output, not sealed
# experiment evidence. Keep experiment-* trees available for explicit sealing.
/artifacts/acceptance*/
/artifacts/major-model-acceptance/
/artifacts/pre-physical-acceptance/
/artifacts/ci-*/
/artifacts/installer-rollback-logs/
/artifacts/p0_baseline/installer-rollback-logs/
/artifacts/p0_baseline/runtime-profiles/
/artifacts/actions-python-versions-manifest.json
/artifacts/installer-*.json
/artifacts/installer-*.xml
/artifacts/integration-*.xml
/artifacts/rc-*.xml
/artifacts/release-identity-*.json
/artifacts/release-job-*.log
/artifacts/unit-*.xml
/artifacts/wheel-*.json
/artifacts/windows-*.json

# Runtime/test state may contain live endpoints or generated credentials and
# can include permission-protected files. Ignore it wherever a harness nests it.
/artifacts/**/temp/
/artifacts/**/tmp/
/artifacts/**/test-temp/
/artifacts/**/pytest-temp*/
/artifacts/**/*-temp/
/artifacts/**/scratch/
/artifacts/**/.runtime/
/artifacts/**/runtime/
/artifacts/**/pairing-invitations/
/artifacts/**/replay/
/artifacts/**/requests/
/artifacts/**/.cache/
