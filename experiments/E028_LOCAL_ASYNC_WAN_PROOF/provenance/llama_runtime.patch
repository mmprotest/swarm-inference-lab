+std::pair<int, int> e027_qwen35_stage_bounds(int n_layer) {
+    const char * start_text = std::getenv("E027_STAGE_START");
+    const char * end_text = std::getenv("E027_STAGE_END");
+    if (start_text == nullptr && end_text == nullptr) {
+        return {0, n_layer};
+    }
+    if (start_text == nullptr || end_text == nullptr) {
+        throw std::runtime_error("E027 stage bounds must set both start and end");
+    }
+    const int start = std::stoi(start_text);
+    const int end = std::stoi(end_text);
+    if (start < 0 || end <= start || end > n_layer) {
+        throw std::runtime_error("invalid E027 Qwen35 stage bounds");
+    }
+    return {start, end};
+}
