<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- This project has no NuGet package references; avoid a nondeterministic audit network call. -->
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>SwarmBootstrap.ContractTests</AssemblyName>
    <RootNamespace>SwarmBootstrap.ContractTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SwarmBootstrap\SwarmBootstrap.csproj" />
  </ItemGroup>
</Project>
